# define your env variables for the test env here

KERNEL_CLASS='Augias\Test\Kernel'
# At least 32 bytes: the trusted-device cookie is a JWT signed with it.
AUGIAS_APP_SECRET='$ecretf0rt3st-at-least-32-bytes-long'
AUGIAS_APP_DEBUG=0
SYMFONY_DEPRECATIONS_HELPER=999999
PANTHER_ERROR_SCREENSHOT_DIR=./var/error-screenshots
FOUNDRY_FAKER_SEED=91847

APP_ENV=test
APP_DEBUG=0

AUGIAS_LEMON_SQUEEZY_API_KEY=test-api-key
AUGIAS_LEMON_SQUEEZY_STORE_ID=test-store
AUGIAS_LEMON_SQUEEZY_WEBHOOK_SECRET=test-secret
