{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:category', {width: 24, height: 24, class: 'me-2'}) }}{{ 'category.menu.list'|trans }}
{% endblock title %}

{% block heading %}
    {% if route_allowed('_categories_add') %}
    <a class="btn btn-primary" href="{{ path("_categories_add") }}">
        {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
        {{ 'category.grid.create'|trans }}
    </a>
    {% endif %}
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <twig:DataGrid name="category_grid" />
    </twig:Ui:Card>
{% endblock %}
