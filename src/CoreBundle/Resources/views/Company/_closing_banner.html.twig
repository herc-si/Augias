{#
 # Shown on every page of a company scheduled for closure: when it goes, that
 # it is read-only until then, and the two things still worth doing.
 #}
{% set closesAt = company_closes_at() %}
{% if closesAt %}
    {% set subscriptionEnded = company_closure_reason() == 'subscription_ended' %}
    {% set keys = subscriptionEnded ? 'company.subscription_ended.banner' : 'company.closing.banner' %}
    <div class="alert alert-warning d-flex flex-column flex-md-row align-items-md-center gap-3 no-print" role="alert">
        <div class="flex-fill">
            <strong>{{ (keys ~ '.title')|trans({'%date%': closesAt|date('d/m/Y')}) }}</strong>
            <div class="small">{{ (keys ~ '.text')|trans }}</div>
        </div>
        <div class="d-flex gap-2 flex-shrink-0">
            {% if route_allowed('_export_list') %}
                <a class="btn btn-sm btn-primary" href="{{ path('_export_list') }}">
                    {{ ux_icon('tabler:database-export', {width: 16, height: 16, 'aria-hidden': 'true'}) }}
                    {{ 'company.closing.banner.export'|trans }}
                </a>
            {% endif %}
            {% if subscriptionEnded %}
                {% set renewUrl = optional_path('saas_subscription_plans') %}
                {% if renewUrl %}
                    <a class="btn btn-sm" href="{{ renewUrl }}">{{ 'company.subscription_ended.banner.renew'|trans }}</a>
                {% endif %}
            {% elseif is_granted('company.close') %}
                <form method="post" action="{{ path('_cancel_company_closure') }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('cancel_company_closure') }}">
                    <button class="btn btn-sm">{{ 'company.closing.banner.cancel'|trans }}</button>
                </form>
            {% endif %}
        </div>
    </div>
{% endif %}
