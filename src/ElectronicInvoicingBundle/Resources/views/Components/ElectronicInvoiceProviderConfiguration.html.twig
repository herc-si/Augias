<div {{ attributes }}>
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="mb-0">
            {% if not isNewSetting %}
                {{ providerSetting.name }}
            {% else %}
                {{ 'einvoicing.provider.add'|trans }}
            {% endif %}
        </h4>
    </div>

    {% if showDeleteConfirmation %}
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-title">{{ 'einvoicing.provider.delete_title'|trans }}</h4>
            <p>
                {{ 'einvoicing.provider.delete_confirm'|trans }} <strong>{{ providerSetting.name }}</strong> ?
                {{ 'einvoicing.provider.delete_warning'|trans }}
            </p>
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-ghost" data-action="live#action" data-live-action-param="cancelDelete">
                    {{ 'action.cancel'|trans }}
                </button>
                <button type="button" class="btn btn-danger" data-action="live#action" data-live-action-param="confirmDelete" data-loading="addAttribute(disabled)">
                    {{ ux_icon('tabler:trash', {width: 16, height: 16}) }}
                    {{ 'action.delete'|trans }}
                </button>
            </div>
        </div>
    {% else %}
        {% if not isNewSetting and providerSetting.heldByThePlatform %}
            <twig:Ui:Alert type="warning" icon="tabler:plug-connected-x" class="mb-4">
                <strong>{{ 'einvoicing.account.stopped.title'|trans }}</strong>
                {{ ('einvoicing.account.explain.' ~ providerSetting.accountVerification.value)|trans }}
                {{ 'einvoicing.account.stopped.resume'|trans }}
            </twig:Ui:Alert>
        {% endif %}

        {% if connection is not null %}
            {# The deployment has its own SUPER PDP application: the company
             # connects its account there — signing up and having its identity
             # verified on the way — instead of pasting credentials. #}
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <h5 class="card-title mb-1 d-flex align-items-center gap-2">
                                {{ 'einvoicing.super_pdp.connection.title'|trans }}
                                {% if connection.connected %}
                                    <span class="badge bg-green-lt">{{ 'einvoicing.super_pdp.connection.connected'|trans }}</span>
                                {% elseif connection.url %}
                                    <span class="badge bg-red-lt">{{ 'einvoicing.super_pdp.connection.not_connected'|trans }}</span>
                                {% endif %}
                            </h5>
                            <p class="text-secondary small mb-0">
                                {% if connection.connected %}
                                    {{ 'einvoicing.super_pdp.connection.help_connected'|trans }}
                                {% elseif connection.url %}
                                    {{ 'einvoicing.super_pdp.connection.help_disconnected'|trans }}
                                {% else %}
                                    {{ 'einvoicing.super_pdp.connection.help_new'|trans }}
                                {% endif %}
                            </p>
                        </div>
                        {% if connection.url %}
                            <a href="{{ connection.url }}" class="btn {{ connection.connected ? 'btn-outline-secondary' : 'btn-primary' }} flex-shrink-0">
                                {{ ux_icon('tabler:plug-connected', {width: 18, height: 18}) }}
                                {{ (connection.connected ? 'einvoicing.super_pdp.connection.reconnect' : 'einvoicing.super_pdp.connection.connect')|trans }}
                            </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}

        {% if canCheckAccount %}
            {# The platform refuses everything until it has verified the
             # company's identity, so this is the first thing to know about an
             # account — asked on demand, since it is a call to a third party. #}
            <div class="card mb-4">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <h5 class="card-title mb-1">{{ 'einvoicing.account.title'|trans }}</h5>
                            <p class="text-secondary small mb-0">{{ 'einvoicing.account.help'|trans }}</p>
                        </div>
                        <button type="button" class="btn btn-outline-primary" data-action="live#action" data-live-action-param="checkAccount" data-loading="addAttribute(disabled)">
                            {{ ux_icon('tabler:shield-check', {width: 18, height: 18}) }}
                            {{ 'einvoicing.account.check'|trans }}
                        </button>
                    </div>

                    {% if accountStatus is not null %}
                        {% set verified = accountStatus.verification == 'verified' %}
                        <div class="mt-3">
                            <span class="badge {{ verified ? 'bg-green-lt' : (accountStatus.verification == 'needs_review' ? 'bg-yellow-lt' : 'bg-red-lt') }}">
                                {{ ('einvoicing.account.verification.' ~ accountStatus.verification)|trans }}
                            </span>
                            {% if accountStatus.environment %}
                                <span class="badge {{ accountStatus.environment == 'sandbox' ? 'bg-azure-lt' : 'bg-secondary-lt' }} ms-1">
                                    {{ ('einvoicing.account.environment.' ~ accountStatus.environment)|trans }}
                                </span>
                            {% endif %}
                            {% if accountStatus.companyName %}
                                <div class="mt-2">
                                    {{ accountStatus.companyName }}{% if accountStatus.companyNumber %} <span class="text-secondary">({{ accountStatus.companyNumber }})</span>{% endif %}
                                </div>
                            {% endif %}
                            {% if accountStatus.error %}
                                <div class="text-danger small mt-2">{{ accountStatus.error|trans }}</div>
                            {% elseif not verified %}
                                <div class="text-secondary small mt-2">{{ ('einvoicing.account.explain.' ~ accountStatus.verification)|trans }}</div>
                            {% endif %}
                            {% for warning in accountStatus.warnings %}
                                <twig:Ui:Alert type="warning" icon="tabler:alert-triangle" class="mt-2 mb-0">{{ warning|trans }}</twig:Ui:Alert>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {{ form_start(form, {
            attr: {
                'data-action': 'live#action:prevent',
                'data-live-action-param': 'save'
            }
        }) }}
            <div class="mb-4">
                {{ form_widget(form) }}
            </div>
        {{ form_end(form) }}

        <div class="d-flex justify-content-between align-items-center gap-3">
            {% if not isNewSetting %}
                <button type="button" class="btn btn-outline-danger" data-action="live#action" data-live-action-param="showDeleteConfirmation">
                    {{ ux_icon('tabler:trash', {width: 18, height: 18}) }}
                    {{ 'action.delete'|trans }}
                </button>
            {% else %}
                <a href="{{ path('_einvoicing_providers') }}" class="btn btn-ghost">
                    {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                    {{ 'action.cancel'|trans }}
                </a>
            {% endif %}
            <button type="submit" class="btn btn-primary" data-action="live#action" data-live-action-param="save" data-loading="addAttribute(disabled)">
                {% if connection is not null and isNewSetting %}
                    {{ ux_icon('tabler:external-link', {width: 18, height: 18}) }}
                    {{ 'einvoicing.super_pdp.connection.continue'|trans }}
                {% else %}
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                    {{ 'action.save'|trans }}
                {% endif %}
            </button>
        </div>
    {% endif %}
</div>
