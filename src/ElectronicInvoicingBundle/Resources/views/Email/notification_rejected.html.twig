{% extends "@AugiasCore/Layout/Email/notification.html.twig" %}
{% import "@AugiasCore/Layout/Email/components.html.twig" as email %}

{%- block title -%}
    {{ 'einvoicing.notification_rejected.heading'|trans({}, 'email') }}
{%- endblock -%}

{%- block content -%}
    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #dc2626; font-size: 16px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                    ⚠️ {{ 'einvoicing.notification_rejected.alert'|trans({}, 'email') }}
                </p>
                <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                    {{ 'einvoicing.notification_rejected.message'|trans({}, 'email') }}
                </p>
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {# Invoice details #}
    {{ email.info_row('einvoicing.notification_rejected.invoice_number'|trans({}, 'email'), invoice_number(invoice) ?? invoice.id) }}

    {% if client %}
        {{ email.spacer('xs') }}
        {{ email.info_row('einvoicing.notification_rejected.client'|trans({}, 'email'), client.name) }}
    {% elseif invoice.client %}
        {{ email.spacer('xs') }}
        {{ email.info_row('einvoicing.notification_rejected.client'|trans({}, 'email'), invoice.client.name) }}
    {% endif %}

    {{ email.spacer('xs') }}
    {{ email.info_row('einvoicing.notification_rejected.provider'|trans({}, 'email'), submission.provider|replace({'_': ' '})|capitalize) }}

    {{ email.spacer('xs') }}
    {{ email.info_row('einvoicing.notification_rejected.status_code'|trans({}, 'email'), statusCode) }}

    {{ email.divider('md') }}

    {# View button #}
    {{ email.button('einvoicing.notification_rejected.view_invoice'|trans({}, 'email'), url('_invoices_view', {'id': invoice.id}), 'primary', 'large') }}

    {{ email.spacer('md') }}
{%- endblock -%}
