{% extends "@AugiasCore/Layout/Email/notification.html.twig" %}
{% import "@AugiasCore/Layout/Email/components.html.twig" as email %}

{%- block title -%}
    {{ problem.translationKey('heading')|trans({}, 'email') }}
{%- endblock -%}

{%- block content -%}
    {% apply inky_to_html %}
        <row>
            <columns>
                <p style="color: #dc2626; font-size: 16px; font-weight: 600; line-height: 1.5; margin: 0 0 16px 0; Margin: 0 0 16px 0;">
                    ⚠️ {{ problem.translationKey('heading')|trans({}, 'email') }}
                </p>
                <p style="color: #1e293b; font-size: 16px; line-height: 1.5; margin: 0 0 24px 0; Margin: 0 0 24px 0;">
                    {{ problem.translationKey('message')|trans({}, 'email') }}
                </p>
            </columns>
        </row>
    {% endapply %}

    {{ email.spacer('sm') }}

    {{ email.info_row('einvoicing.notification_problem.company'|trans({}, 'email'), company.name) }}

    {% if invoice %}
        {{ email.spacer('xs') }}
        {{ email.info_row('einvoicing.notification_problem.invoice_number'|trans({}, 'email'), (number is defined and number ? number : (invoice_number(invoice) ?? invoice.id))) }}
        {{ email.spacer('xs') }}
        {{ email.info_row('einvoicing.notification_problem.client'|trans({}, 'email'), invoice.client.name) }}
    {% endif %}

    {% if detail %}
        {{ email.spacer('xs') }}
        {{ email.info_row('einvoicing.notification_problem.detail'|trans({}, 'email'), detail|trans) }}
    {% endif %}

    {{ email.divider('md') }}

    {% if invoice %}
        {{ email.button('einvoicing.notification_problem.view_invoice'|trans({}, 'email'), (creditNote is defined and creditNote is not null ? url('_credit_notes_view', {'id': creditNote.id}) : url('_invoices_view', {'id': invoice.id})), 'primary', 'large') }}
    {% else %}
        {{ email.button('einvoicing.notification_problem.view_settings'|trans({}, 'email'), url('_einvoicing_providers'), 'primary', 'large') }}
    {% endif %}

    {{ email.spacer('md') }}
{%- endblock -%}
