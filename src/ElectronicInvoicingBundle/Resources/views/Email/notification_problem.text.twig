{# Plain text: nothing here is HTML, and a French apostrophe must not come out as &#039;. #}
{% autoescape false %}
{{ problem.translationKey('heading')|trans({}, 'email') }}
{{ '='|repeat(60) }}

{{ problem.translationKey('message')|trans({}, 'email') }}

{{ 'einvoicing.notification_problem.company'|trans({}, 'email') }}: {{ company.name }}
{% if invoice -%}
{{ 'einvoicing.notification_problem.invoice_number'|trans({}, 'email') }}: {{ (number is defined and number ? number : (invoice_number(invoice) ?? invoice.id)) }}
{{ 'einvoicing.notification_problem.client'|trans({}, 'email') }}: {{ invoice.client.name }}
{% endif -%}
{% if detail -%}
{{ 'einvoicing.notification_problem.detail'|trans({}, 'email') }}: {{ detail|trans }}
{% endif %}

{{ '-'|repeat(60) }}
{% if invoice -%}
{{ 'einvoicing.notification_problem.view_invoice'|trans({}, 'email') }}: {{ (creditNote is defined and creditNote is not null ? url('_credit_notes_view', {'id': creditNote.id}) : url('_invoices_view', {'id': invoice.id})) }}
{% else -%}
{{ 'einvoicing.notification_problem.view_settings'|trans({}, 'email') }}: {{ url('_einvoicing_providers') }}
{% endif -%}
{% endautoescape %}
