{#
 # The electronic inbox: invoices that arrived on their own and have not been
 # turned into purchase invoices yet.
 #
 # Each row links straight to creating the bill from that receipt, because that
 # is the only thing anybody does with one. Sending the user to a list to find
 # it again would be a step for nothing.
 #}
<twig:Ui:Card>
    <twig:block name="header">
        <div class="d-flex justify-content-between align-items-center w-100">
            <div>
                <h3 class="card-title mb-0">{{ 'dashboard.einvoicing.incoming_title'|trans }}</h3>
                <small class="text-muted">{{ 'dashboard.einvoicing.incoming_subtitle'|trans }}</small>
            </div>
            <a href="{{ path('_einvoicing_incoming') }}" class="btn btn-sm btn-ghost">
                {{ 'dashboard.einvoicing.view_all'|trans }}
                {{ ux_icon('tabler:arrow-right', {width: 16, height: 16}) }}
            </a>
        </div>
    </twig:block>

    {% import '@AugiasDashboard/money.html.twig' as money %}

    {% if receipts is empty %}
        {#
         # An empty inbox is good news for a feature that runs in the background:
         # it says the polling is working and there is nothing waiting, which is
         # not the same as saying nothing at all.
         #}
        <div class="attention-empty">
            <div class="attention-empty-icon">
                {{ ux_icon('tabler:check', {width: 32, height: 32}) }}
            </div>
            <p class="attention-empty-text">{{ 'dashboard.einvoicing.inbox_empty'|trans }}</p>
        </div>
    {% else %}
        <div class="attention-items">
            {% for receipt in receipts %}
                <a href="{{ path('_bills_create_from_receipt', {id: receipt.id}) }}" class="attention-item">
                    <span class="attention-item-main">
                        {% if receipt.invoiceNumber %}
                            <span class="attention-item-id">{{ receipt.invoiceNumber }}</span>
                        {% endif %}
                        {#
                         # A receipt carries the seller's name as the platform sent
                         # it, not a Client: nothing has been matched to a supplier
                         # in this company's books yet — that happens when the bill
                         # is created.
                         #}
                        <span class="attention-item-client">
                            {{ receipt.sellerName ?: 'dashboard.einvoicing.unknown_seller'|trans }}
                        </span>
                    </span>
                    <span class="attention-item-meta">
                        {% if receipt.totalAmount is not null and receipt.currencyCode %}
                            {# Neutral: nothing about an arriving invoice is paid or overdue yet. #}
                            <span class="attention-item-amount">
                                {{ money.money(receipt.totalAmount, receipt.currencyCode) }}
                            </span>
                        {% endif %}
                        {% if receipt.issueDate %}
                            <span class="attention-item-date">{{ receipt.issueDate|format_date_skeleton('dMMM') }}</span>
                        {% endif %}
                    </span>
                </a>
            {% endfor %}
        </div>

        {% if awaitingTotal > receipts|length %}
            <div class="d-flex align-items-center justify-content-between gap-2 px-3 py-2">
                <span class="text-secondary small">
                    {{ 'dashboard.attention.showing'|trans({'%shown%': receipts|length, '%total%': awaitingTotal}) }}
                </span>
                <a href="{{ path('_einvoicing_incoming') }}" class="btn btn-sm btn-ghost">
                    {{ 'dashboard.attention.view_all'|trans }}
                    {{ ux_icon('tabler:arrow-right', {width: 14, height: 14}) }}
                </a>
            </div>
        {% endif %}
    {% endif %}
</twig:Ui:Card>
