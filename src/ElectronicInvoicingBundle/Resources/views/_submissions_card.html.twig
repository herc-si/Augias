{#
 # What the electronic invoicing platform did with a document: each
 # submission, its status and its dated history. Shared by the invoice and the
 # credit note pages.
 #
 # Parameters: submissions — the document's ElectronicInvoiceSubmission list.
 #}
{% if submissions|length > 0 %}
    <div class="doc-sidebar-card">
        <div class="doc-sidebar-card-header">
            <div class="doc-sidebar-card-icon">
                {{ ux_icon('tabler:building-broadcast-tower', {width: 18, height: 18}) }}
            </div>
            <h3 class="doc-sidebar-card-title">{{ 'einvoicing.view.title'|trans }}</h3>
        </div>
        <div class="doc-sidebar-card-body">
            <div class="d-flex flex-column gap-3">
                {% for submission in submissions %}
                    <div class="d-flex align-items-start justify-content-between gap-2">
                        <div class="min-w-0">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                {{ einvoicing_status_label(einvoicing_processing_status(submission)) }}
                                <span class="text-muted small">{{ submission.provider|replace({'_': ' '})|capitalize }}</span>
                            </div>
                            {% if submission.externalReference is not empty %}
                                <div class="text-muted small mt-1">{{ submission.externalReference }}</div>
                            {% endif %}
                            {% if not submission.success and submission.message is not empty %}
                                <div class="text-danger small mt-1">{{ submission.message|trans }}</div>
                            {% endif %}
                        </div>
                        <div class="text-muted small text-nowrap">{{ submission.created|format_datetime('medium', 'short') }}</div>
                    </div>
                    {% if submission.events|length > 0 %}
                        <ol class="list-unstyled small border-start ps-3 ms-1 mb-0" aria-label="{{ 'einvoicing.view.history'|trans }}">
                            {% for event in submission.events %}
                                <li class="{{ loop.last ? '' : 'mb-2' }}">
                                    <div class="d-flex justify-content-between gap-2">
                                        <span class="{{ loop.last ? 'fw-medium' : '' }}">{{ einvoicing_status_code_label(event.statusCode) }}</span>
                                        <time class="text-muted text-nowrap" datetime="{{ event.occurredAt|date('c') }}">{{ event.occurredAt|format_datetime('short', 'short') }}</time>
                                    </div>
                                    {% if event.reason or event.note %}
                                        <div class="text-muted">
                                            {{ einvoicing_reason_label(event.reason) }}{% if event.reason and event.note %} — {% endif %}{{ event.note }}
                                        </div>
                                    {% endif %}
                                </li>
                            {% endfor %}
                        </ol>
                    {% endif %}
                {% endfor %}
            </div>
            <div class="mt-3">
                {{ include('@AugiasElectronicInvoicing/_sync_button.html.twig', {class: 'btn-sm w-100'}) }}
            </div>
        </div>
    </div>
{% endif %}

