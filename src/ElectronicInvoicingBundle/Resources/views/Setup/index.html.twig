{% extends '@AugiasCore/Layout/default.html.twig' %}

{% block title %}{{ ux_icon('tabler:file-certificate', {width: 24, height: 24, class: 'me-2'}) }}{{ 'einvoicing.setup.title'|trans }}{% endblock %}

{% macro step_badge(done, current) %}
    {% if done %}
        <span class="badge bg-success-lt">{{ ux_icon('tabler:check', {width: 14, height: 14, 'aria-hidden': 'true'}) }} {{ 'einvoicing.setup.step_done'|trans }}</span>
    {% elseif current %}
        <span class="badge bg-primary-lt">{{ 'einvoicing.setup.step_current'|trans }}</span>
    {% else %}
        <span class="badge bg-secondary-lt">{{ 'einvoicing.setup.step_later'|trans }}</span>
    {% endif %}
{% endmacro %}

{% block content %}
    {% import _self as setup %}
    {% set step = progress.currentStep %}
    <div class="settings-page">
        {% include "@AugiasCore/flash.html.twig" %}

        {% if progress.done %}
            <twig:Ui:Alert type="success" icon="tabler:circle-check" title="{{ 'einvoicing.setup.done.title'|trans }}">
                {{ 'einvoicing.setup.done.message'|trans }}
            </twig:Ui:Alert>
        {% else %}
            <p class="text-secondary mb-4">{{ 'einvoicing.setup.intro'|trans }}</p>
        {% endif %}

        <ul class="steps steps-green steps-counter mb-4" aria-label="{{ 'einvoicing.setup.title'|trans }}">
            {% for number, key in {1: 'identity', 2: 'platform', 3: 'verification'} %}
                <li class="step-item{{ (progress.done ? 3 : step) == number ? ' active' }}">{{ ('einvoicing.setup.' ~ key ~ '.title')|trans }}</li>
            {% endfor %}
        </ul>

        {# 1. Who the company is #}
        <div class="card mb-4" id="identity">
            <div class="card-header">
                <h3 class="card-title">1. {{ 'einvoicing.setup.identity.title'|trans }}</h3>
                <div class="card-actions">{{ setup.step_badge(progress.identityDone, step == 1) }}</div>
            </div>
            {% if progress.identityDone and not editing %}
                <div class="card-body d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3">
                    <p class="mb-0 text-secondary">{{ 'einvoicing.setup.identity.done'|trans }}</p>
                    <a href="{{ path('_einvoicing_setup', {edit: 1}) }}#identity" class="btn btn-outline-primary">
                        {{ ux_icon('tabler:edit', {width: 18, height: 18}) }} {{ 'einvoicing.setup.identity.edit'|trans }}
                    </a>
                </div>
            {% else %}
                {{ form_start(form) }}
                <div class="card-body">
                    <p class="text-secondary">{{ 'einvoicing.setup.identity.help'|trans }}</p>
                    {% if next %}
                        <twig:Ui:Alert type="info" icon="tabler:info-circle">{{ 'einvoicing.setup.identity.before_checkout'|trans }}</twig:Ui:Alert>
                    {% endif %}
                    {% if lookedUp is same as(true) %}
                        <twig:Ui:Alert type="success" icon="tabler:building">{{ 'einvoicing.setup.identity.found'|trans({'%name%': form.vars.value.registryName}) }}</twig:Ui:Alert>
                    {% elseif lookedUp is same as(false) %}
                        <twig:Ui:Alert type="warning" icon="tabler:alert-triangle">{{ 'einvoicing.setup.identity.not_found'|trans }}</twig:Ui:Alert>
                    {% endif %}
                    {{ form_errors(form) }}

                    <div class="row g-3 align-items-start">
                        <div class="col-sm-8">{{ form_row(form.siren) }}</div>
                        <div class="col-sm-4 pt-sm-4">{{ form_widget(form.lookUp, {attr: {class: 'btn btn-outline-primary w-100 mt-sm-1'}}) }}</div>
                    </div>
                    <div class="row g-3">
                        <div class="col-sm-6">{{ form_row(form.siret) }}</div>
                        <div class="col-sm-6">{{ form_row(form.vatExempt) }}</div>
                    </div>
                    {{ form_row(form.vatNumber) }}
                    {{ form_row(form.street1) }}
                    {{ form_row(form.street2) }}
                    <div class="row g-3">
                        <div class="col-sm-4">{{ form_row(form.zip) }}</div>
                        <div class="col-sm-8">{{ form_row(form.city) }}</div>
                    </div>
                    {{ form_row(form.registryName) }}
                </div>
                <div class="card-footer">
                    <div class="form-actions">
                        {% if progress.identityDone %}
                            <a href="{{ path('_einvoicing_setup') }}" class="btn btn-ghost">{{ 'action.cancel'|trans }}</a>
                        {% endif %}
                        {{ form_widget(form.save, {label: (next ? 'einvoicing.setup.identity.save_and_pay' : 'einvoicing.setup.identity.save')}) }}
                    </div>
                </div>
                {{ form_end(form) }}
            {% endif %}
        </div>

        {# 2. The platform #}
        <div class="card mb-4" id="platform">
            <div class="card-header">
                <h3 class="card-title">2. {{ 'einvoicing.setup.platform.title'|trans }}</h3>
                <div class="card-actions">{{ setup.step_badge(progress.connected, step == 2) }}</div>
            </div>
            <div class="card-body">
                {% if progress.connected %}
                    <p class="mb-0">{{ 'einvoicing.setup.platform.connected'|trans({'%name%': progress.platform.name}) }}</p>
                {% elseif progress.canConnectHere %}
                    <p>{{ 'einvoicing.setup.platform.help'|trans }}</p>
                    <ul class="text-secondary mb-3">
                        <li>{{ 'einvoicing.setup.platform.what_1'|trans }}</li>
                        <li>{{ 'einvoicing.setup.platform.what_2'|trans }}</li>
                        <li>{{ 'einvoicing.setup.platform.what_3'|trans }}</li>
                    </ul>
                    {% if progress.identityDone %}
                        <form method="post" action="{{ path('_einvoicing_setup_connect') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('einvoicing_setup_connect') }}">
                            <button type="submit" class="btn btn-primary">
                                {{ ux_icon('tabler:plug-connected', {width: 18, height: 18}) }} {{ 'einvoicing.setup.platform.connect'|trans }}
                            </button>
                        </form>
                    {% else %}
                        <p class="text-secondary mb-0">{{ 'einvoicing.setup.platform.identity_first'|trans }}</p>
                    {% endif %}
                {% else %}
                    <p>{{ 'einvoicing.setup.platform.self_hosted'|trans }}</p>
                    <a href="{{ path('_einvoicing_providers') }}" class="btn btn-outline-primary">
                        {{ ux_icon('tabler:building-broadcast-tower', {width: 18, height: 18}) }} {{ 'einvoicing.setup.platform.choose'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>

        {# 3. The platform's verification #}
        <div class="card mb-4" id="verification">
            <div class="card-header">
                <h3 class="card-title">3. {{ 'einvoicing.setup.verification.title'|trans }}</h3>
                <div class="card-actions">{{ setup.step_badge(progress.verified, step == 3 and not progress.verified) }}</div>
            </div>
            <div class="card-body">
                {% if not progress.connected %}
                    <p class="text-secondary mb-0">{{ 'einvoicing.setup.verification.later'|trans }}</p>
                {% elseif progress.verified %}
                    <p class="mb-0">{{ 'einvoicing.setup.verification.verified'|trans }}</p>
                {% else %}
                    {% set state = progress.verification ? progress.verification.value : 'pending' %}
                    <twig:Ui:Alert type="{{ state == 'failed' ? 'danger' : 'warning' }}" icon="{{ state == 'failed' ? 'tabler:circle-x' : 'tabler:clock' }}">
                        {{ ('einvoicing.setup.verification.' ~ state)|trans }}
                    </twig:Ui:Alert>
                    <form method="post" action="{{ path('_einvoicing_setup_check') }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('einvoicing_setup_check') }}">
                        <button type="submit" class="btn btn-outline-primary">
                            {{ ux_icon('tabler:refresh', {width: 18, height: 18}) }} {{ 'einvoicing.setup.verification.check'|trans }}
                        </button>
                    </form>
                {% endif %}
            </div>
        </div>

        {% if progress.done %}
            <div class="d-flex justify-content-end">
                <a href="{{ path('_dashboard') }}" class="btn btn-primary">{{ ux_icon('tabler:layout-dashboard', {width: 18, height: 18}) }} {{ 'einvoicing.setup.done.dashboard'|trans }}</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
