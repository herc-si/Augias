<div {{ attributes.defaults({class: 'form-page'}) }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save',
            'class': 'client-form'
        }
    }) }}

    {{ form_errors(form) }}

    <div class="form-page-container form-page-container--medium">
        {# Page Header #}
        <div class="form-page-header">
            <div class="form-page-header-content">
                <div class="form-page-icon">
                    {{ ux_icon('tabler:building-store', {width: 28, height: 28}) }}
                </div>
                <div>
                    {% if client is not empty %}
                        <h1 class="form-page-title">{{ 'edit_client'|trans }} - {{ client }}</h1>
                    {% else %}
                        <h1 class="form-page-title">{{ 'add_client'|trans }}</h1>
                        <p class="form-page-subtitle">{{ 'client.form.subtitle'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        {# Main Form Content - Single Column Flow #}
        <div class="form-page-sections">

            {# Section 0: Role — the first decision, so it comes before anything else #}
            <section class="form-page-section" id="client-role">
                <div class="section-header">
                    <div class="section-icon">
                        {{ ux_icon('tabler:switch-horizontal', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">{{ 'client.form.role_title'|trans }}</h2>
                        <p class="section-description">{{ 'client.form.role_description'|trans }}</p>
                    </div>
                </div>

                <div class="section-content">
                    <div class="role-picker">
                        {{ form_row(form.isClient) }}
                        {{ form_row(form.isSupplier) }}
                    </div>
                </div>
            </section>

            {# Section 1: Business Details #}
            <section class="form-page-section" id="client-info">
                <div class="section-header">
                    <div class="section-icon">
                        {{ ux_icon('tabler:building', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">{{ 'client.info'|trans }}</h2>
                        <p class="section-description">{{ 'client.form.info_description'|trans }}</p>
                    </div>
                </div>

                <div class="section-content">
                    <div class="form-grid">
                        <div class="form-field form-field-wide">
                            {{ form_row(form.name, {
                                attr: {
                                    placeholder: 'client.form.name.placeholder'|trans
                                }
                            }) }}
                        </div>

                        <div class="form-field">
                            {{ form_row(form.website, {
                                attr: {
                                    placeholder: 'https://example.com'
                                }
                            }) }}
                        </div>

                        <div class="form-field">
                            {{ form_row(form.currencyCode) }}
                            {%- if form.currencyCode.vars.feature_gated_active ?? false %}
                                <small class="form-hint text-muted feature-gated-hint">
                                    {%- if form.currencyCode.vars.feature_gated_plan ?? null %}
                                        {{ 'client.form.feature_gated.with_plan'|trans({'%plan%': form.currencyCode.vars.feature_gated_plan}) }}
                                    {%- else %}
                                        {{ 'client.form.feature_gated.generic'|trans }}
                                    {%- endif %}
                                    <a href="{{ path('saas_subscription_plans') }}" class="ms-1">{{ 'client.form.feature_gated.upgrade'|trans }}</a>
                                </small>
                            {%- endif %}
                        </div>

                    </div>
                </div>
            </section>

            {# Section 2: Contacts #}
            <section class="form-page-section" id="client-contacts-collection">
                <div class="section-header">
                    <div class="section-icon section-icon-required">
                        {{ ux_icon('tabler:users', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">
                            {{ 'client.contact.info'|trans }}
                            <span class="badge bg-primary-lt ms-1">{{ 'required'|trans }}</span>
                        </h2>
                        <p class="section-description">{{ 'client.form.contact_description'|trans }}</p>
                    </div>
                </div>

                <div class="section-content">
                    <div class="contacts-list">
                        {% for contact in form.contacts %}
                            {{ form_row(contact) }}
                        {% else %}
                            <div class="empty-contacts-hint">
                                <p class="text-muted mb-0">{{ 'client.contact.empty_hint'|trans }}</p>
                            </div>
                        {% endfor %}
                    </div>

                    {{ form_errors(form.contacts) }}

                    <div class="add-item-action">
                        {{ form_widget(form.contacts.vars.button_add, {
                            label: 'client.contact.add'|trans,
                            attr: {
                                class: 'btn btn-outline-primary add-item-btn'
                            }
                        }) }}
                    </div>
                </div>
            </section>

            {# Section: Fiscal identifiers — always open. SIRET, SIREN and VAT number
             # are what every French business has, and what an e-invoice needs;
             # they used to be hidden in a collapsed list behind a dropdown. #}
            <section class="form-page-section" id="client-fiscal-identifiers">
                <div class="section-header">
                    <div class="section-icon">
                        {{ ux_icon('tabler:receipt-tax', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">{{ 'client.form.fiscal_identifiers_title'|trans }}</h2>
                        <p class="section-description">{{ 'client.form.fiscal_identifiers_description'|trans }}</p>
                    </div>
                </div>
                <div class="section-content">
                    <div class="row g-3">
                        <div class="col-md-4">{{ form_row(form.siret) }}</div>
                        <div class="col-md-4">{{ form_row(form.siren) }}</div>
                        <div class="col-md-4">{{ form_row(form.vatNumber) }}</div>
                    </div>
                </div>
            </section>

            {# Section: Other identifiers (optional, collapsed unless it already has data) #}
            {% set taxIdentifiersOpen = form.otherTaxIdentifiers|length > 0 %}
            <section class="form-page-section client-form-section-optional" id="client-tax-identifiers-collection">
                <div class="section-header section-header-toggle" role="button" tabindex="0" data-bs-toggle="collapse" data-bs-target="#client-tax-identifiers-content" aria-expanded="{{ taxIdentifiersOpen ? 'true' : 'false' }}" aria-controls="client-tax-identifiers-content">
                    <div class="section-icon">
                        {{ ux_icon('tabler:id', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">
                            {{ 'client.form.other_identifiers_title'|trans }}
                            <span class="badge bg-secondary-lt ms-1">{{ 'optional'|trans }}</span>
                        </h2>
                        <p class="section-description">{{ 'client.form.tax_identifiers_description'|trans }}</p>
                    </div>
                    <div class="section-toggle-icon">
                        {{ ux_icon('tabler:chevron-down', {width: 20, height: 20}) }}
                    </div>
                </div>

                <div class="collapse{{ taxIdentifiersOpen ? ' show' : '' }}" id="client-tax-identifiers-content">
                    <div class="section-content">
                        <div class="tax-identifiers-list">
                            {% for taxIdentifier in form.otherTaxIdentifiers %}
                                {{ form_row(taxIdentifier) }}
                            {% endfor %}
                        </div>

                        {{ form_errors(form.otherTaxIdentifiers) }}

                        <div class="add-item-action">
                            {{ form_widget(form.otherTaxIdentifiers.vars.button_add, {
                                label: 'client.tax_identifiers.add'|trans,
                                attr: {
                                    class: 'btn btn-outline-primary add-item-btn'
                                }
                            }) }}
                        </div>
                    </div>
                </div>
            </section>

            {# Section 3: Addresses (Optional, collapsed unless it already has data) #}
            {% set addressesOpen = form.addresses|length > 0 %}
            <section class="form-page-section client-form-section-optional" id="client-address-collection">
                <div class="section-header section-header-toggle" role="button" tabindex="0" data-bs-toggle="collapse" data-bs-target="#client-address-content" aria-expanded="{{ addressesOpen ? 'true' : 'false' }}" aria-controls="client-address-content">
                    <div class="section-icon">
                        {{ ux_icon('tabler:map-pin', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">
                            {{ 'client.address.info'|trans }}
                            <span class="badge bg-secondary-lt ms-1">{{ 'optional'|trans }}</span>
                        </h2>
                        <p class="section-description">{{ 'client.form.address_description'|trans }}</p>
                    </div>
                    <div class="section-toggle-icon">
                        {{ ux_icon('tabler:chevron-down', {width: 20, height: 20}) }}
                    </div>
                </div>

                <div class="collapse{{ addressesOpen ? ' show' : '' }}" id="client-address-content">
                    <div class="section-content">
                        <div class="addresses-list">
                            {% for address in form.addresses %}
                                {{ form_row(address) }}
                            {% else %}
                                <div class="empty-addresses-hint">
                                    <p class="text-muted mb-0">{{ 'client.address.empty_hint'|trans }}</p>
                                </div>
                            {% endfor %}
                        </div>

                        {{ form_errors(form.addresses) }}

                        <div class="add-item-action">
                            {{ form_widget(form.addresses.vars.button_add, {
                                label: 'client.address.add'|trans,
                                attr: {
                                    class: 'btn btn-outline-primary add-item-btn'
                                }
                            }) }}
                        </div>
                    </div>
                </div>
            </section>
            {# Section 4: Custom Fields (Optional, collapsed by default) #}
            {% if form.customFields is defined and form.customFields|length > 0 %}
            <section class="form-page-section client-form-section-optional" id="client-custom-fields">
                <div class="section-header section-header-toggle" role="button" tabindex="0" data-bs-toggle="collapse" data-bs-target="#client-custom-fields-content" aria-expanded="false" aria-controls="client-custom-fields-content">
                    <div class="section-icon">
                        {{ ux_icon('tabler:forms', {width: 20, height: 20}) }}
                    </div>
                    <div class="section-header-text">
                        <h2 class="section-title">{{ 'client.custom_fields'|trans }}</h2>
                    </div>
                    <div class="section-toggle-icon">
                        {{ ux_icon('tabler:chevron-down', {width: 20, height: 20}) }}
                    </div>
                </div>

                <div class="collapse" id="client-custom-fields-content">
                    <div class="section-content">
                        {{ form_widget(form.customFields) }}
                    </div>
                </div>
            </section>
            {% endif %}
        </div>

        {{ form_rest(form) }}

        {# Sticky Footer with Actions #}
        <div class="form-page-actions">
            <div class="form-page-actions-inner form-page-actions-inner--medium">
                <button type="button" class="btn btn-ghost" onclick="history.back()">
                    {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
                    {{ 'client.cancel'|trans }}
                </button>
                <button type="submit" class="btn btn-primary btn-save">
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                    {{ 'client.save'|trans }}
                </button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>
