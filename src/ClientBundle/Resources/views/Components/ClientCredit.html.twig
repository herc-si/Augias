<div {{ attributes }} class="d-flex align-items-center justify-content-between gap-3">
    <div class="client-credit-amount" id="client-credit-value">
        {{ client.credit|formatCurrency(client.currency) }}
    </div>
    <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#add-client-credit">
        {{ ux_icon('tabler:plus', {width: 14, height: 14}) }}
        {{ 'client.view.actions.add_credit'|trans }}
    </button>

    {{ form_start(form, {attr: {'data-action': 'live#action:prevent', 'data-live-action-param': 'save'}}) }}
    <twig:Ui:Modal id="add-client-credit" title="{{ 'client.modal.add_credit'|trans }}">
        {#
         # Credit granted here has no document behind it and writes nothing to
         # the books — which is right, because nothing was received. The warning
         # exists because the field invites the opposite reading: money handed
         # over in cash or as an advance looks like something to record here,
         # and recorded here it would never reach the revenue figures at all.
         # The one legitimate use is the credit a credit note creates, and that
         # one never comes through this form.
         #}
        <twig:Ui:Alert type="warning" icon="tabler:alert-triangle" title="{{ 'client.modal.credit.not_a_receipt.title'|trans }}">
            <p class="mb-0">{{ 'client.modal.credit.not_a_receipt.body'|trans }}</p>
        </twig:Ui:Alert>

        {{ form_row(form) }}

        <twig:block name="footer">
            <button type="button" class="btn btn-ghost" data-bs-dismiss="modal">{{ 'action.cancel'|trans }}</button>
            <button type="submit" class="btn btn-primary">
                {{ ux_icon('tabler:device-floppy', {width: 16, height: 16}) }}
                {{ 'action.save'|trans }}
            </button>
        </twig:block>
    </twig:Ui:Modal>
    {{ form_end(form) }}
</div>
