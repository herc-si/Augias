<div {{ attributes.defaults({class: 'billing-form-page'}) }}>
    {% set currency = dto.client ? dto.client.currency : null %}

    {{ form_start(form) }}

    <div class="billing-form-container">
        <div class="billing-form-header">
            <div class="billing-form-header-content">
                <div class="billing-form-icon">
                    {{ ux_icon('tabler:receipt-refund', {width: 28, height: 28}) }}
                </div>
                <div>
                    {% if isEdit %}
                        <h1 class="billing-form-title">{{ 'credit_note.edit.title'|trans }}</h1>
                    {% else %}
                        <h1 class="billing-form-title">{{ 'credit_note.create.title'|trans }}</h1>
                        <p class="billing-form-subtitle">{{ 'credit_note.create.subtitle'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="billing-details-section">
            <div class="billing-details-grid">
                <div class="billing-details-left">
                    <div class="client-selection">
                        <div{{ form.client.vars.data is not empty ? ' class="d-none"' }}>
                            {{ form_row(form.client, {attr: {'data-action': 'live#$render'}}) }}
                        </div>
                        {% if form.client.vars.data %}
                            {% include "@AugiasClient/Ajax/info.html.twig" with {'client': form.client.vars.data, 'form': form} %}
                        {% endif %}
                    </div>

                    {# Numbered when issued, like an invoice when finalised. #}
                    <div class="mt-3 billing-id-display" data-test="credit-note-number">
                        <span class="billing-id-label">{{ 'credit_note.field.number'|trans }}</span>
                        {% if creditNote is not null and creditNote.numbered %}
                            <span class="billing-id-value">{{ credit_note_number(creditNote) }}</span>
                        {% else %}
                            <span class="billing-id-value text-muted">{{ 'credit_note.number.on_issue'|trans }}</span>
                        {% endif %}
                    </div>
                </div>

                <div class="billing-details-right">
                    {{ form_row(form.reason) }}

                    {% if form.creditedInvoice is defined %}
                        {# Optional: a rebate or a gesture credits no single invoice. #}
                        {{ form_row(form.creditedInvoice) }}
                    {% endif %}

                    {{ form_row(form.creditNoteDate) }}
                </div>
            </div>

        </div>

        <div class="billing-main-grid">
            <div class="billing-items-section">
                {% if form.lines|length == 0 and not this.canAddLines %}
                    {# No line before the client: its currency and taxes price them. #}
                    <div class="empty">
                        <div class="empty-icon">
                            {{ ux_icon('tabler:user', {width: 32, height: 32}) }}
                        </div>
                        <p class="empty-title">{{ 'document_line.client_first_title'|trans }}</p>
                        <p class="empty-subtitle text-muted">{{ 'document_line.client_first'|trans }}</p>
                    </div>
                {% elseif form.lines|length == 0 %}
                    <div class="empty">
                        <p class="empty-title">{{ 'credit_note.items.empty.title'|trans }}</p>
                        <p class="empty-subtitle text-muted">{{ 'credit_note.items.empty.description'|trans }}</p>
                    </div>
                {% else %}
                    <div class="billing-items-list">
                        <div class="billing-items-header-row">
                            <div class="column-description">{{ 'invoice.item.heading.description'|trans }}</div>
                            <div class="column-price">{{ 'invoice.item.heading.price'|trans }}</div>
                            <div class="column-qty">{{ 'invoice.item.heading.qty_unit'|trans }}</div>
                            {% if hasTax %}
                                <div class="column-tax">{{ 'invoice.item.heading.tax'|trans }}</div>
                            {% endif %}
                            <div class="column-total">{{ 'invoice.item.heading.total'|trans }}</div>
                            <div class="column-actions"></div>
                        </div>

                        {% for item in form.lines|sort((a, b) => (a.vars.value.position ?? 0) <=> (b.vars.value.position ?? 0)) %}
                            {% if item.vars.value.note|default(false) %}
                                {# A line of text only: a heading over the lines that follow. #}
                                <div class="billing-item-row billing-item-note">
                                    <div class="column-description">
                                        {{ form_widget(item.description, {attr: {placeholder: 'document_line.note_placeholder'|trans, rows: 1}}) }}
                                        {{ form_errors(item.description) }}
                                        <div class="d-none">{{ form_rest(item) }}</div>
                                    </div>
                                    <div class="column-actions">
                                        <div class="line-order-actions">
                                            {{ include('@AugiasCore/Components/_line_order_buttons.html.twig', {item: item}) }}
                                            {% if form.lines|length > 1 %}
                                                {{ form_widget(item.vars.button_delete, {
                                                    label: ux_icon('tabler:trash', {width: 16, height: 16})|raw,
                                                    label_html: true,
                                                    attr: {class: 'btn btn-sm remove-item-btn', title: 'invoice.item.remove'|trans, 'aria-label': 'invoice.item.remove'|trans}
                                                }) }}
                                            {% else %}
                                                {# Not shown for a lone line, so form_end would render it
                                                   below the form, out of place: it is marked as rendered. #}
                                                {% do item.vars.button_delete.setRendered() %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="billing-item-row">
                                    <div class="column-description">
                                        <span class="mobile-label">{{ 'invoice.item.heading.description'|trans }}</span>
                                        {{ form_widget(item.description, {attr: {placeholder: 'credit_note.item.description.placeholder'|trans, rows: 2}}) }}
                                        {{ form_errors(item.description) }}
                                        {{ form_widget(item.note) }}{{ form_widget(item.position) }}
                                        {%- if item.supplyType is defined %}
                                            {# Goods or a service: when the VAT on the line falls due. Under the
                                             # description, like the disbursement switch, rather than in a column
                                             # of its own that most invoices would carry for nothing. #}
                                            <div class="item-supply-type">{{ form_widget(item.supplyType, {attr: {'aria-label': 'form.field.supply_type'|trans}}) }}</div>
                                        {%- endif %}
                                    </div>
                                    <div class="column-price">
                                        <span class="mobile-label">{{ 'invoice.item.heading.price'|trans }}</span>
                                        {{ form_widget(item.price) }}
                                        {{ form_errors(item.price) }}
                                    </div>
                                    <div class="column-qty">
                                        <span class="mobile-label">{{ 'invoice.item.heading.qty'|trans }}</span>
                                        {{ form_widget(item.qty) }}
                                        {{ form_errors(item.qty) }}
                                        {%- if item.unit is defined %}
                                            <div class="item-unit mt-1">{{ form_widget(item.unit, {attr: {'aria-label': 'form.field.unit'|trans}}) }}</div>
                                        {%- endif %}
                                    </div>
                                    {% if hasTax and item.taxes is defined %}
                                        <div class="column-tax">
                                            <span class="mobile-label">{{ 'invoice.item.heading.tax'|trans }}</span>
                                            <div class="line-tax-collection" {{ stimulus_controller('line-tax') }}>
                                                {% if item.taxes|length > 0 %}
                                                    <div class="line-tax-list">
                                                        {% for lineTax in item.taxes %}
                                                            <div class="line-tax-row" data-line-tax-target="row">
                                                                <div class="line-tax-field line-tax-field-tax">
                                                                    {{ form_widget(lineTax.tax) }}
                                                                    {{ form_errors(lineTax.tax) }}
                                                                </div>
                                                                {{ form_widget(lineTax.sequence) }}
                                                                <div class="line-tax-actions">
                                                                    {{ form_widget(lineTax.vars.button_delete, {
                                                                        label: ux_icon('tabler:x', {width: 14, height: 14})|raw,
                                                                        label_html: true,
                                                                        attr: {class: 'btn btn-sm line-tax-remove-btn', title: 'invoice.item.tax.remove'|trans, 'aria-label': 'invoice.item.tax.remove'|trans}
                                                                    }) }}
                                                                </div>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                {% endif %}
                                                {{ form_widget(item.taxes.vars.button_add, {
                                                    label: 'invoice.item.tax.add'|trans,
                                                    attr: {class: 'line-tax-add-btn'}
                                                }) }}
                                            </div>
                                        </div>
                                    {% endif %}
                                    <div class="column-total">
                                        <span class="mobile-label">{{ 'invoice.item.heading.total'|trans }}</span>
                                        <span class="item-total-value">{{ item.vars.value.total|formatCurrency(currency) }}</span>
                                    </div>
                                    <div class="column-actions">
                                        <div class="line-order-actions">
                                            {{ include('@AugiasCore/Components/_line_order_buttons.html.twig', {item: item}) }}
                                            {% if form.lines|length > 1 %}
                                                {{ form_widget(item.vars.button_delete, {
                                                    label: ux_icon('tabler:trash', {width: 16, height: 16})|raw,
                                                    label_html: true,
                                                    attr: {class: 'btn btn-sm remove-item-btn', title: 'invoice.item.remove'|trans, 'aria-label': 'invoice.item.remove'|trans}
                                                }) }}
                                            {% else %}
                                                {# Not shown for a lone line, so form_end would render it
                                                   below the form, out of place: it is marked as rendered. #}
                                                {% do item.vars.button_delete.setRendered() %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}

                <div class="add-item-action d-flex align-items-center gap-2 flex-wrap">
                    {{ form_widget(form.lines.vars.button_add, {
                        label: 'invoice.item.add'|trans,
                        attr: {class: 'add-item-btn btn-sm', disabled: not this.canAddLines}
                    }) }}
                    <button type="button" class="btn btn-sm add-item-btn" data-action="live#action" data-live-action-param="addNote"{% if not this.canAddLines %} disabled{% endif %}>
                        {{ ux_icon('tabler:text-plus', {width: 16, height: 16}) }} {{ 'document_line.add_note'|trans }}
                    </button>
                    {% if creditedInvoiceSummary %}
                        <button type="button" class="btn btn-sm add-item-btn" id="credit-note-copy-lines" data-action="live#action" data-live-action-param="copyInvoiceLines" title="{{ 'credit_note.copy_lines.help'|trans }}">
                            {{ ux_icon('tabler:copy', {width: 16, height: 16}) }} {{ 'credit_note.copy_lines.label'|trans }}
                        </button>
                    {% endif %}
                    {% if not this.canAddLines and form.lines|length > 0 %}
                        <small class="text-muted">{{ 'document_line.client_first'|trans }}</small>
                    {% endif %}
                </div>

                {% if invoiceDiscount %}
                    {# Not a field: the credited invoice's own discount, carried over
                     # so the credit note gives back what was actually invoiced. #}
                    <div class="billing-discount-row mt-3 text-muted small" id="credit-note-invoice-discount">
                        {{ ux_icon('tabler:percentage', {width: 16, height: 16, class: 'me-1'}) }}
                        {% if invoiceDiscount.type == 'money' %}
                            {{ 'credit_note.discount.mirrored_amount'|trans({'%amount%': invoiceDiscount.valueMoney|formatCurrency(currency)}) }}
                        {% else %}
                            {{ 'credit_note.discount.mirrored_percent'|trans({'%rate%': invoiceDiscount.valuePercentage|format_number}) }}
                        {% endif %}
                    </div>
                {% endif %}
            </div>

            <div class="billing-totals-sidebar">
                <div class="billing-totals-card">
                    <div class="billing-totals-header">
                        <div class="billing-totals-icon">
                            {{ ux_icon('tabler:calculator', {width: 20, height: 20}) }}
                        </div>
                        <h2 class="billing-totals-title">{{ 'credit_note.totals.title'|trans }}</h2>
                    </div>

                    <div class="billing-totals-body">
                        <div class="totals-row">
                            <span class="totals-label">{{ 'billing.subtotal'|trans }}</span>
                            <span class="totals-value">{{ dto.baseTotal|formatCurrency(currency) }}</span>
                        </div>

                        {% if invoiceDiscount %}
                            <div class="totals-row totals-row-discount">
                                <span class="totals-label">{{ 'credit_note.discount.label'|trans }}</span>
                                <span class="totals-value">{{ discountAmount|formatCurrency(currency) }}</span>
                            </div>
                        {% endif %}

                        {% if hasTax %}
                            <div class="totals-row">
                                <span class="totals-label">{{ 'billing.tax'|trans }}</span>
                                <span class="totals-value">{{ dto.tax|formatCurrency(currency) }}</span>
                            </div>
                        {% endif %}

                        {#
                         # Shown as what the client is owed rather than as a negative
                         # figure: the amount is stored positive, and the document
                         # itself says which way it runs.
                         #}
                        <div class="totals-row totals-row-total">
                            <span class="totals-label">{{ 'credit_note.totals.credited'|trans }}</span>
                            <span class="totals-value">{{ dto.total|formatCurrency(currency) }}</span>
                        </div>
                    </div>
                </div>

                {% if creditedInvoiceSummary %}
                    {% set credited = creditedInvoiceSummary.invoice %}
                    {# The invoice being credited, beside the lines that credit it:
                     # what it charged, what is still owed, and what credit notes
                     # already took back, so it is not credited twice. #}
                    <div class="billing-totals-card billing-credited-invoice-card" id="credit-note-invoice-summary">
                        <div class="billing-totals-header">
                            <div class="billing-totals-icon">
                                {{ ux_icon('tabler:file-invoice', {width: 20, height: 20}) }}
                            </div>
                            <h2 class="billing-totals-title">{{ 'credit_note.invoice_summary.title'|trans({'%number%': invoice_number(credited)}) }}</h2>
                        </div>

                        <div class="billing-totals-body">
                            <div class="totals-row">
                                <span class="totals-label">{{ 'invoice.grid.status'|trans }}</span>
                                <span class="totals-value">{{ invoice_label(credited.status) }}</span>
                            </div>
                            <div class="totals-row">
                                <span class="totals-label">{{ 'credit_note.invoice_summary.date'|trans }}</span>
                                <span class="totals-value">{{ credited.invoiceDate ? credited.invoiceDate|format_date('medium') : '—' }}</span>
                            </div>
                            <div class="totals-row">
                                <span class="totals-label">{{ 'credit_note.invoice_summary.total'|trans }}</span>
                                <span class="totals-value">{{ creditedInvoiceSummary.total|formatCurrency(currency) }}</span>
                            </div>
                            <div class="totals-row">
                                <span class="totals-label">{{ 'credit_note.invoice_summary.balance'|trans }}</span>
                                <span class="totals-value">{{ creditedInvoiceSummary.balance|formatCurrency(currency) }}</span>
                            </div>
                            <div class="totals-row">
                                <span class="totals-label">{{ 'credit_note.invoice_summary.already_credited'|trans }}</span>
                                <span class="totals-value">{{ creditedInvoiceSummary.alreadyCredited|formatCurrency(currency) }}</span>
                            </div>
                            <div class="pt-3">
                                <a href="{{ path('_invoices_view', {'id': credited.id}) }}" target="_blank" rel="noopener" class="btn btn-sm w-100">
                                    {{ ux_icon('tabler:external-link', {width: 16, height: 16}) }}
                                    {{ 'credit_note.invoice_summary.view'|trans }}
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <details class="billing-terms-section"{{ hasTermsOrNotes ? ' open' : '' }}>
            <summary class="terms-summary" aria-label="{{ 'invoice.terms_notes.toggle'|trans }}">
                <span class="terms-summary-icon">
                    {{ ux_icon('tabler:chevron-right', {width: 18, height: 18}) }}
                </span>
                <span class="terms-summary-text">
                    <span class="terms-summary-title">{{ 'invoice.terms_notes.title'|trans }}</span>
                    <span class="badge bg-secondary-lt">{{ 'optional'|trans }}</span>
                </span>
            </summary>
            <div class="terms-content">
                <div class="terms-grid">
                    {{ form_row(form.terms) }}
                    {{ form_row(form.notes) }}
                </div>
            </div>
        </details>

        {#
         # No recipients block here: @AugiasClient/Ajax/info.html.twig renders
         # the contact checkboxes as part of the client card above, and Twig
         # refuses to render a field twice.
         #}
        <div class="billing-form-actions">
            <div class="billing-form-actions-inner">
                <a href="{{ path('_credit_notes_index') }}" class="btn btn-ghost">
                    {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
                    {{ 'invoice.save.cancel'|trans }}
                </a>

                <div class="btn-group save-button-group">
                    <button type="button" class="btn btn-primary btn-save-primary" {{ live_action('saveDraft:prevent') }}>
                        {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                        {{ 'credit_note.save.draft'|trans }}
                    </button>
                    <button type="button" class="btn btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">{{ 'invoice.view.toolbar.toggle_dropdown'|trans }}</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li>
                            {# Issuing is what fixes the document. Nothing undoes it. #}
                            <button type="button" class="dropdown-item" {{ live_action('saveIssue:prevent') }}>
                                {{ ux_icon('tabler:check', {width: 16, height: 16}) }}
                                {{ 'credit_note.save.issue'|trans }}
                            </button>
                        </li>
                        {% if not is_email_verification_gated() %}
                            <li>
                                <button type="button" class="dropdown-item" {{ live_action('saveSend:prevent') }}>
                                    {{ ux_icon('tabler:send', {width: 16, height: 16}) }}
                                    {{ 'credit_note.save.send'|trans }}
                                </button>
                            </li>
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>
