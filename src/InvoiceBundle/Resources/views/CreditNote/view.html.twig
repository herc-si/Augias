{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block page_title %}{{ 'credit_note.title'|trans({'%id%': creditNote.creditNoteId}) }}{% endblock %}

{% block content %}
    {% set currency = creditNote.client.currency %}

    <div class="doc-view-header">
        <div class="doc-view-header-left">
            <div class="doc-view-icon">
                {{ ux_icon('tabler:receipt-refund', {width: 32, height: 32}) }}
            </div>
            <div class="doc-view-title-group">
                <h1 class="doc-view-title">{{ 'credit_note.title'|trans({'%id%': creditNote.creditNoteId}) }}</h1>
                <div class="doc-view-meta">
                    {{ credit_note_label(creditNote.status) }}
                    <span class="doc-view-meta-item">
                        {{ ux_icon('tabler:calendar', {width: 14, height: 14}) }}
                        {{ creditNote.creditNoteDate|date('M d, Y') }}
                    </span>
                    <span class="doc-view-meta-item">
                        {{ ux_icon('tabler:tag', {width: 14, height: 14}) }}
                        {{ creditNote.reason ? creditNote.reason.translationKey|trans : '' }}
                    </span>
                </div>
            </div>
        </div>

        <div class="doc-view-header-actions">
            <div class="doc-view-utility-actions">
                <button type="button" onclick="window.print()" class="btn btn-ghost btn-icon" title="{{ 'invoice.action.print'|trans }}">
                    {{ ux_icon('tabler:printer', {width: 20, height: 20}) }}
                </button>
                {% if can_print_pdf() %}
                    <a href="{{ path('_credit_notes_view', {'id': creditNote.id, '_format': 'pdf'}) }}" target="_blank" class="btn btn-ghost btn-icon" title="{{ 'invoice.action.pdf'|trans }}">
                        {{ ux_icon('tabler:file-type-pdf', {width: 20, height: 20}) }}
                    </a>
                {% endif %}
            </div>

            <div class="doc-view-primary-actions">
                {# Editing is a draft-only affair; once issued the document is fixed. #}
                {% if not creditNote.issued %}
                    <a href="{{ path('_credit_notes_edit', {'id': creditNote.id}) }}" class="btn btn-outline-primary">
                        {{ ux_icon('tabler:pencil', {width: 18, height: 18}) }}
                        {{ 'action.edit'|trans }}
                    </a>
                {% endif %}

                {% if workflow_can(creditNote, 'issue') %}
                    <a href="{{ path('_action_credit_note', {'action': 'issue', 'id': creditNote.id}) }}" class="btn btn-primary">
                        {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                        {{ 'credit_note.action.issue'|trans }}
                    </a>
                {% endif %}

                {% if creditNote.users|length > 0 %}
                    <a href="{{ path('_credit_notes_send', {'id': creditNote.id}) }}" class="btn btn-outline-primary">
                        {{ ux_icon('tabler:send', {width: 18, height: 18}) }}
                        {{ 'credit_note.action.send'|trans }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <twig:Ui:Card>
                {% if creditNote.creditedInvoice %}
                    {#
                     # The reference to the corrected invoice is not decoration:
                     # a credit note that does not name what it corrects is not
                     # a usable document.
                     #}
                    <div class="alert alert-info d-flex align-items-center gap-2" role="note">
                        {{ ux_icon('tabler:link', {width: 18, height: 18}) }}
                        <span>
                            {{ 'credit_note.credits_invoice'|trans }}
                            <a href="{{ path('_invoices_view', {'id': creditNote.creditedInvoice.id}) }}">
                                {{ creditNote.creditedInvoice.invoiceId }}
                            </a>
                        </span>
                    </div>
                {% endif %}

                <table class="table">
                    <thead>
                        <tr>
                            <th>{{ 'invoice.item.heading.description'|trans }}</th>
                            <th class="text-end">{{ 'invoice.item.heading.price'|trans }}</th>
                            <th class="text-end">{{ 'invoice.item.heading.qty'|trans }}</th>
                            <th class="text-end">{{ 'invoice.item.heading.total'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for line in creditNote.lines %}
                            <tr>
                                <td>{{ line.description|nl2br }}</td>
                                <td class="text-end">{{ line.price|formatCurrency(currency) }}</td>
                                <td class="text-end">{{ line.qty }}</td>
                                <td class="text-end">{{ line.total|formatCurrency(currency) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>

                {% if creditNote.terms or creditNote.notes %}
                    <div class="mt-3">
                        {% if creditNote.terms %}
                            <h3 class="h5">{{ 'form.field.terms'|trans }}</h3>
                            <p class="text-muted">{{ creditNote.terms|nl2br }}</p>
                        {% endif %}
                        {% if creditNote.notes %}
                            <h3 class="h5">{{ 'billing.notes'|trans }}</h3>
                            <p class="text-muted">{{ creditNote.notes|nl2br }}</p>
                        {% endif %}
                    </div>
                {% endif %}
            </twig:Ui:Card>
        </div>

        <div class="col-lg-4">
            <twig:Ui:Card>
                <h2 class="h4">{{ 'credit_note.totals.title'|trans }}</h2>

                <div class="totals-row">
                    <span class="totals-label">{{ 'billing.subtotal'|trans }}</span>
                    <span class="totals-value">{{ creditNote.baseTotal|formatCurrency(currency) }}</span>
                </div>
                <div class="totals-row">
                    <span class="totals-label">{{ 'billing.tax'|trans }}</span>
                    <span class="totals-value">{{ creditNote.tax|formatCurrency(currency) }}</span>
                </div>
                <div class="totals-row totals-row-total">
                    <span class="totals-label">{{ 'credit_note.totals.credited'|trans }}</span>
                    <span class="totals-value">{{ creditNote.total|formatCurrency(currency) }}</span>
                </div>
            </twig:Ui:Card>

            <twig:Ui:Card class="mt-3">
                <h2 class="h4">{{ 'credit_note.allocation.title'|trans }}</h2>

                {#
                 # What is still owed on this credit note. The client's balance
                 # holds the same figure, but only this page can say which
                 # invoice consumed which credit.
                 #}
                <div class="totals-row totals-row-total">
                    <span class="totals-label">{{ 'credit_note.allocation.remaining'|trans }}</span>
                    <span class="totals-value">{{ remaining|formatCurrency(currency) }}</span>
                </div>

                {% if creditNote.allocations|length > 0 %}
                    <table class="table table-sm mt-2">
                        <tbody>
                            {% for allocation in creditNote.allocations %}
                                <tr>
                                    <td>
                                        {{ allocation.kind.translationKey|trans }}
                                        {% if allocation.invoice %}
                                            —
                                            <a href="{{ path('_invoices_view', {'id': allocation.invoice.id}) }}">
                                                {{ allocation.invoice.invoiceId }}
                                            </a>
                                        {% endif %}
                                        <br />
                                        <small class="text-muted">{{ allocation.allocatedOn|date('M d, Y') }}</small>
                                    </td>
                                    <td class="text-end">{{ allocation.amount|formatCurrency(currency) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="text-muted mb-0">{{ 'credit_note.allocation.none'|trans }}</p>
                {% endif %}

                {% if allocationForm %}
                    <hr />
                    {{ form_start(allocationForm) }}
                        {{ form_row(allocationForm.kind) }}
                        {{ form_row(allocationForm.invoice) }}
                        {{ form_row(allocationForm.amount) }}
                        {{ form_row(allocationForm.allocatedOn) }}
                        {{ form_row(allocationForm.notes) }}
                        <button type="submit" class="btn btn-primary w-100">
                            {{ ux_icon('tabler:arrow-down-circle', {width: 18, height: 18}) }}
                            {{ 'credit_note.allocation.record'|trans }}
                        </button>
                    {{ form_end(allocationForm) }}
                {% endif %}
            </twig:Ui:Card>

            <twig:Ui:Card class="mt-3">
                <h2 class="h4">{{ 'credit_note.client'|trans }}</h2>
                <p>
                    <a href="{{ path('_clients_view', {'id': creditNote.client.id}) }}">{{ creditNote.client.name }}</a>
                </p>
                {% if creditNote.issuedAt %}
                    <p class="text-muted mb-0">
                        {{ 'credit_note.issued_at'|trans }}: {{ creditNote.issuedAt|date('M d, Y H:i') }}
                    </p>
                {% endif %}
            </twig:Ui:Card>
        </div>
    </div>
{% endblock content %}
