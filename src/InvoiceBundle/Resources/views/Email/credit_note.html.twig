{% extends "@AugiasCore/Layout/Email/base.html.twig" %}

{%- block title -%}
    {{ 'credit_note.title'|trans({'%id%': credit_note_number(creditNote)}, 'email') }}
{%- endblock -%}

{% block content %}
    {% set currency = creditNote.client.currency %}

    <p>{{ 'credit_note.email.intro'|trans({'%id%': credit_note_number(creditNote)}) }}</p>

    {% if creditNote.creditedInvoice %}
        <p>{{ 'credit_note.email.credits_invoice'|trans({'%invoice%': invoice_number(creditNote.creditedInvoice)}) }}</p>
    {% endif %}

    <table role="presentation" width="100%">
        <tr>
            <td>{{ 'billing.subtotal'|trans }}</td>
            <td align="right">{{ creditNote.baseTotal|formatCurrency(currency) }}</td>
        </tr>
        <tr>
            <td>{{ 'billing.tax'|trans }}</td>
            <td align="right">{{ creditNote.tax|formatCurrency(currency) }}</td>
        </tr>
        <tr>
            <td><strong>{{ 'credit_note.totals.credited'|trans }}</strong></td>
            <td align="right"><strong>{{ creditNote.total|formatCurrency(currency) }}</strong></td>
        </tr>
    </table>
{% endblock %}
