{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:file-report', {width: 24, height: 24, class: 'me-2'}) }}{{ 'accounting.declaration.title'|trans({'%year%': year}) }}
{% endblock title %}

{% block content %}
    {% if regime is null %}
        <twig:Ui:Card title="{{ 'accounting.setup.title'|trans }}">
            <p class="text-muted mb-0">{{ 'accounting.setup.description'|trans }}</p>
        </twig:Ui:Card>
    {% elseif rows is empty and missing is empty %}
        <twig:Ui:Card title="{{ 'accounting.declaration.empty_title'|trans }}">
            <p class="text-muted mb-0">{{ 'accounting.declaration.empty'|trans }}</p>
        </twig:Ui:Card>
    {% else %}
        <twig:Ui:Card>
            <div class="table-responsive">
                <table class="table card-table table-vcenter">
                    <thead>
                        <tr>
                            <th>{{ 'accounting.declaration.period'|trans }}</th>
                            <th>{{ 'accounting.declaration.period_status'|trans }}</th>
                            <th>{{ 'accounting.declaration.status'|trans }}</th>
                            <th class="text-end">{{ 'accounting.declaration.due'|trans }}</th>
                            <th class="w-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rows %}
                            <tr>
                                <td>
                                    {{ row.period.label }}
                                    <div class="text-muted small">
                                        {{ ux_icon(row.kind.icon, {width: 14, height: 14, class: 'me-1'}) }}
                                        {{ row.kind.translationKey|trans }}
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-{{ row.period.status.color }}-lt">
                                        {{ row.period.status.translationKey|trans }}
                                    </span>
                                </td>
                                <td>
                                    {% if row.declaration is null %}
                                        <span class="text-muted">{{ 'accounting.declaration.not_computed'|trans }}</span>
                                    {% else %}
                                        <span class="badge bg-{{ row.declaration.status.color }}-lt">
                                            {{ row.declaration.status.translationKey|trans }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if row.declaration is not null %}
                                        {{ row.declaration.totalDue|formatCurrency(row.declaration.currencyCode) }}
                                    {% endif %}
                                </td>
                                <td>
                                    <a class="btn btn-ghost btn-sm" href="{{ path('_accounting_declaration_view', {'id': row.period.id}) }}">
                                        {{ 'accounting.declaration.open'|trans }}
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}

                        {#
                         # Periods with no row at all. Nothing has been written for
                         # these — they are what the calendar says should exist —
                         # so they carry no status, no figures and no link, only
                         # the button that brings one into being.
                         #
                         # Muted rather than alarming: a quarter with nothing in it
                         # is an ordinary thing for a small business, and the point
                         # is to make it visible, not to imply it is late.
                         #}
                        {% for period in missing %}
                            <tr class="text-muted">
                                <td>{{ period.label }}</td>
                                <td>
                                    <span class="badge bg-gray-lt">{{ 'accounting.period.not_created'|trans }}</span>
                                </td>
                                <td>
                                    <span class="text-muted">{{ 'accounting.declaration.not_computed'|trans }}</span>
                                </td>
                                <td class="text-end"></td>
                                <td>
                                    {% if route_allowed('_accounting_period_create') %}
                                    <form method="post" action="{{ path('_accounting_period_create') }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('accounting_period_create') }}">
                                        {#
                                         # Any date inside the period: the manager
                                         # derives the ordinal and the boundaries
                                         # from the periodicity, so this cannot
                                         # disagree with a period created by filing
                                         # an entry into it.
                                         #}
                                        <input type="hidden" name="date" value="{{ period.startDate|date('Y-m-d') }}">
                                        {# Which cycle: VAT can run on its own. #}
                                        <input type="hidden" name="type" value="{{ period.type.value }}">
                                        <button type="submit" class="btn btn-ghost btn-sm">
                                            {{ ux_icon('tabler:plus', {width: 16, height: 16}) }}
                                            {{ 'accounting.period.create'|trans }}
                                        </button>
                                    </form>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Ui:Card>
    {% endif %}
{% endblock %}
