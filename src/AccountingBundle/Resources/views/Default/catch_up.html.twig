{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:history', {width: 24, height: 24, class: 'me-2'}) }}{{ 'accounting.catch_up.title'|trans }}
{% endblock title %}

{% block content %}
    <twig:Ui:Card>
        <p class="text-secondary">{{ 'accounting.catch_up.intro'|trans }}</p>

        {# A plain GET: changing the day only recomputes what would be added. #}
        <form method="get" action="{{ path('_accounting_catch_up') }}" class="row g-2 align-items-end">
            <div class="col-sm-auto">
                <label class="form-label" for="catch-up-from">{{ 'accounting.catch_up.from'|trans }}</label>
                <input type="date" class="form-control" id="catch-up-from" name="from"
                       value="{{ plan.from|date('Y-m-d') }}"
                       {% if plan.earliestStart is not null %}min="{{ plan.earliestStart|date('Y-m-d') }}"{% endif %}
                       max="{{ 'today'|date('Y-m-d') }}">
            </div>
            <div class="col-sm-auto">
                <button type="submit" class="btn btn-outline-primary">{{ 'accounting.catch_up.refresh'|trans }}</button>
            </div>
        </form>

        {% if plan.earliestStart is not null %}
            <p class="text-muted small mt-2 mb-0">
                {{ ux_icon('tabler:lock', {width: 14, height: 14, class: 'me-1'}) }}
                {{ 'accounting.catch_up.locked_until'|trans({'%date%': plan.earliestStart|format_date('long')}) }}
            </p>
        {% endif %}
    </twig:Ui:Card>

    {% if plan.isEmpty %}
        <twig:Ui:Card class="mt-3">
            <div class="empty">
                <div class="empty-icon">{{ ux_icon('tabler:circle-check', {width: 32, height: 32}) }}</div>
                <p class="empty-title">{{ 'accounting.catch_up.empty.title'|trans }}</p>
                <p class="empty-subtitle text-secondary">{{ 'accounting.catch_up.empty.description'|trans({'%date%': plan.from|format_date('long')}) }}</p>
            </div>
        </twig:Ui:Card>
    {% else %}
        <twig:Ui:Card class="mt-3">
            <twig:block name="header">
                <div>
                    <h3 class="card-title">{{ 'accounting.catch_up.missing'|trans({'%count%': plan.entries|length}) }}</h3>
                    <p class="card-subtitle text-card-subtitle">{{ 'accounting.catch_up.missing_since'|trans({'%date%': plan.from|format_date('long')}) }}</p>
                </div>
            </twig:block>

            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ 'accounting.entry.grid.date'|trans }}</th>
                            <th>{{ 'accounting.catch_up.book'|trans }}</th>
                            <th>{{ 'accounting.entry.grid.document_reference'|trans }}</th>
                            <th>{{ 'accounting.entry.grid.label'|trans }}</th>
                            <th class="text-end">{{ 'accounting.entry.grid.amount'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for entry in plan.entries %}
                            <tr>
                                <td class="text-nowrap">{{ entry.entryDate|format_date('medium') }}</td>
                                <td>{{ entry.book.translationKey|trans }}</td>
                                <td>{{ entry.documentReference }}</td>
                                <td>{{ entry.label }}</td>
                                <td class="text-end text-nowrap">{{ entry.amount|formatCurrency(entry.currencyCode) }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <twig:block name="footer">
                <form method="post" action="{{ path('_accounting_catch_up') }}" class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
                    <input type="hidden" name="from" value="{{ plan.from|date('Y-m-d') }}">
                    <span class="text-muted small">{{ 'accounting.catch_up.help'|trans }}</span>
                    <button type="submit" class="btn btn-primary">
                        {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                        {{ 'accounting.catch_up.confirm'|trans({'%count%': plan.entries|length}) }}
                    </button>
                </form>
            </twig:block>
        </twig:Ui:Card>
    {% endif %}
{% endblock %}
