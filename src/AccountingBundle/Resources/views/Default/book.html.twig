{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:book', {width: 24, height: 24, class: 'me-2'}) }}{{ book.translationKey|trans }}
{% endblock title %}

{% block heading %}
    <a class="btn btn-primary" href="{{ path('_accounting_entry_add', {'book': book.value}) }}">
        {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
        {{ book.addTranslationKey|trans }}
    </a>
{% endblock %}

{% block content %}
    {% if period is not null and period.isClosed %}
        <twig:Ui:Alert type="info" icon="tabler:lock">
            {{ 'accounting.period.sealed_notice'|trans({'%period%': period.label}) }}
        </twig:Ui:Alert>
    {% endif %}

    <twig:Ui:Card>
        <twig:DataGrid name="ledger_entry_grid" />
    </twig:Ui:Card>
{% endblock %}
