{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:book', {width: 24, height: 24, class: 'me-2'}) }}{{ book.translationKey|trans }}
{% endblock title %}

{% block heading %}
    {# The revenue book writes itself: LedgerFeeder files an entry on every
     # payment the application captures, so a button inviting the owner to do
     # it by hand would mostly produce duplicates. The manual path stays, as a
     # quiet link, for money that arrived outside the application — cash, a
     # transfer never recorded here — without which a livre des recettes could
     # not be complete. #}
    {% if not book.acceptsManualEntries %}
        {# The sales journal mirrors issued documents one for one: there is
         # nothing to write in it by hand, so nothing is offered. #}
    {% elseif book.value == 'revenue' %}
        {% if route_allowed('_accounting_entry_add') %}
        <a class="btn btn-link text-secondary" href="{{ path('_accounting_entry_add', {'book': book.value}) }}">
            {{ 'accounting.entry.add_revenue_manual'|trans }}
        </a>
        {% endif %}
    {% else %}
        {% if route_allowed('_accounting_entry_add') %}
        <a class="btn btn-primary" href="{{ path('_accounting_entry_add', {'book': book.value}) }}">
            {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
            {{ book.addTranslationKey|trans }}
        </a>
        {% endif %}
    {% endif %}
{% endblock %}

{% block content %}
    {% if book.value == 'revenue' %}
        <p class="text-secondary">{{ 'accounting.book.revenue_is_automatic'|trans }}</p>
    {% elseif book.value == 'sales' %}
        <p class="text-secondary">{{ 'accounting.book.sales_notice'|trans }}</p>
    {% elseif book.value == 'bills' %}
        <p class="text-secondary">{{ 'accounting.book.bills_notice'|trans }}</p>
    {% elseif book.value == 'expense' %}
        <p class="text-secondary">{{ 'accounting.book.expense_notice'|trans }}</p>
    {% endif %}

    {% if period is not null and period.isClosed %}
        <twig:Ui:Alert type="info" icon="tabler:lock">
            {{ 'accounting.period.sealed_notice'|trans({'%period%': period.label}) }}
        </twig:Ui:Alert>
    {% endif %}

    <twig:Ui:Card>
        <twig:DataGrid name="ledger_entry_grid" :context="ledger_entry_grid_context" />
    </twig:Ui:Card>
{% endblock %}
