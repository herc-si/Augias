{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:calculator', {width: 24, height: 24, class: 'me-2'}) }}{{ 'accounting.menu.main'|trans }}
{% endblock title %}

{% block heading %}
    {% if regime is not null %}
        <a class="btn btn-primary" href="{{ path('_accounting_declarations') }}">
            {{ ux_icon('tabler:file-report', {width: 18, height: 18}) }}
            {{ 'accounting.declaration.menu'|trans }}
        </a>
    {% endif %}
{% endblock %}

{% block content %}
    {% if regime is null %}
        <twig:Ui:Card title="{{ 'accounting.setup.title'|trans }}">
            <p class="text-muted mb-4">{{ 'accounting.setup.description'|trans }}</p>

            {% if route_allowed('_settings') %}
            <a class="btn btn-primary" href="{{ path('_settings') }}">
                {{ ux_icon('tabler:settings', {width: 18, height: 18}) }}
                {{ 'accounting.setup.action'|trans }}
            </a>
            {% endif %}
        </twig:Ui:Card>
    {% else %}
        <div class="row row-cards">
            <div class="col-lg-8">
                {# Title and subtitle go through the header block rather than
                   the component's own props: `.card-header` is a flex row, and
                   the two props are rendered as two of its children, so they
                   end up side by side. Wrapping them is what Tabler's own
                   markup does. #}
                <twig:Ui:Card>
                    <twig:block name="header">
                        <div>
                            <h3 class="card-title">{{ 'accounting.turnover.title'|trans({'%year%': year}) }}</h3>
                            <p class="card-subtitle text-card-subtitle">{{ 'accounting.turnover.subtitle'|trans }}</p>
                        </div>
                    </twig:block>

                    {% if turnover is null or turnover.isEmpty %}
                        <p class="text-muted mb-0">{{ 'accounting.turnover.empty'|trans }}</p>
                    {% else %}
                        <div class="h1 mb-3">{{ turnover.total|formatCurrency(turnover.currencyCode) }}</div>

                        {% if turnover.activeNatures|length > 1 %}
                            <dl class="row mb-3">
                                {% for nature in turnover.activeNatures %}
                                    <dt class="col-sm-6">{{ nature.translationKey|trans }}</dt>
                                    <dd class="col-sm-6">{{ turnover.forNature(nature)|formatCurrency(turnover.currencyCode) }}</dd>
                                {% endfor %}
                            </dl>
                        {% endif %}

                        {% if turnover.hasForeignCurrencies %}
                            <twig:Ui:Alert type="warning" icon="tabler:coins">
                                {{ 'accounting.declaration.warning.foreign_currency'|trans }}
                            </twig:Ui:Alert>
                        {% endif %}

                        {% for limit in limits %}
                            {{ include('@AugiasAccounting/Widget/_limit_bar.html.twig', {
                                limit: limit,
                                currencyCode: turnover.currencyCode,
                            }) }}
                        {% endfor %}

                        <p class="text-muted small mb-0">{{ 'accounting.declaration.warning.rates_unverified'|trans }}</p>
                    {% endif %}
                </twig:Ui:Card>
            </div>

            <div class="col-lg-4">
                <twig:Ui:Card title="{{ 'accounting.period.title'|trans }}">
                    {% if period is null %}
                        <p class="text-muted mb-0">{{ 'accounting.period.none'|trans }}</p>
                    {% else %}
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="h2 mb-0">{{ period.label }}</span>
                            <span class="badge bg-{{ period.status.color }}-lt">{{ period.status.translationKey|trans }}</span>
                        </div>

                        {% if lockDate is not null %}
                            {#
                             # The cran between "still being kept" and "sealed":
                             # entries in periods that ended by this date cannot
                             # be changed any more, whether or not they have been
                             # sealed. Shown here because this card is where a
                             # user comes to ask what state the books are in.
                             #}
                            <p class="text-muted small">
                                {{ ux_icon('tabler:lock', {width: 14, height: 14, class: 'me-1'}) }}
                                {{ 'accounting.period.books_shut_until'|trans({'%date%': lockDate|format_date('long')}) }}
                            </p>
                        {% endif %}

                        {% if period.isOpen and periodHasEnded %}
                            <p class="text-muted">{{ 'accounting.period.close_help'|trans }}</p>

                            {% if route_allowed('_accounting_period_close') %}
                            <form method="post" action="{{ path('_accounting_period_close', {'id': period.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('close' ~ period.id) }}">
                                <button type="submit" class="btn btn-outline-primary w-100">
                                    {{ ux_icon('tabler:lock', {width: 18, height: 18}) }}
                                    {{ 'accounting.period.close'|trans({'%period%': period.label}) }}
                                </button>
                            </form>
                            {% endif %}
                        {% elseif period.isOpen %}
                            {#
                             # No close button while the period is still running.
                             # Money received before its end date still belongs in
                             # it, and a sealed period cannot take it — the entry
                             # would land in a closed period, outside the hash
                             # chain the seal had just computed. Saying when it can
                             # be closed beats offering a button that is refused.
                             #}
                            <p class="text-muted mb-0">
                                {{ 'accounting.period.still_running'|trans({'%date%': period.endDate|format_date('long')}) }}
                            </p>
                        {% else %}
                            <p class="text-muted mb-0">
                                {{ 'accounting.period.closed_on'|trans({'%date%': period.closedAt|format_date('long')}) }}
                            </p>
                        {% endif %}
                    {% endif %}
                </twig:Ui:Card>

                <twig:Ui:Card title="{{ 'accounting.books.title'|trans }}" class="mt-3">
                    <div class="list-group list-group-flush">
                        {% for book in books %}
                            <a class="list-group-item list-group-item-action d-flex align-items-center"
                               href="{{ path('_accounting_book', {'book': book.value}) }}">
                                {{ ux_icon('tabler:book', {width: 18, height: 18, class: 'me-2'}) }}
                                {{ book.translationKey|trans }}
                            </a>
                        {% endfor %}
                    </div>
                </twig:Ui:Card>
            </div>

            {#
             # The figures here are counts of minor units, which is what
             # `formatCurrency` takes. ThresholdAlert also offers `getMoney()`
             # and `getThresholdMoney()`, which return a Money object the filter
             # does not accept — passing one throws, and this card only renders
             # for a company that has actually crossed something.
             #}
            {% if alerts is not empty %}
                <div class="col-12">
                    <twig:Ui:Card title="{{ 'accounting.alerts.title'|trans({'%year%': year}) }}">
                        <div class="list-group list-group-flush">
                            {% for alert in alerts %}
                                <div class="list-group-item">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span>
                                            {{ ux_icon('tabler:alert-triangle', {width: 18, height: 18, class: 'me-2 text-' ~ (alert.step >= 100 ? 'danger' : 'warning')}) }}
                                            {{ 'accounting.alerts.line'|trans({
                                                '%percent%': alert.step,
                                                '%amount%': alert.thresholdAmount|formatCurrency(alert.currencyCode),
                                            }) }}
                                        </span>
                                        <span class="text-muted">{{ alert.triggeredAt|format_date('long') }}</span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </twig:Ui:Card>
                </div>
            {% endif %}

            <div class="col-12">
                <twig:Ui:Card>
                    <twig:block name="header">
                        <div>
                            <h3 class="card-title">{{ regime.labelKey|trans }}</h3>
                            <p class="card-subtitle text-card-subtitle">{{ regime.descriptionKey|trans }}</p>
                        </div>
                    </twig:block>

                    <dl class="row mb-0">
                        <dt class="col-sm-5">{{ 'accounting.settings.primary_activity.label'|trans }}</dt>
                        <dd class="col-sm-7">{{ profile.primaryActivity.translationKey|trans }}</dd>

                        <dt class="col-sm-5">{{ 'accounting.settings.declaration_periodicity.label'|trans }}</dt>
                        <dd class="col-sm-7">{{ profile.declarationPeriodicity.translationKey|trans }}</dd>

                        <dt class="col-sm-5">{{ 'accounting.settings.vat_exempt.label'|trans }}</dt>
                        <dd class="col-sm-7">
                            {% if profile.vatExempt %}
                                <span class="badge bg-green-lt">{{ 'accounting.vat_exempt.yes'|trans }}</span>
                                <div class="text-muted mt-1">{{ profile.vatExemptMention }}</div>
                            {% else %}
                                <span class="badge bg-gray-lt">{{ 'accounting.vat_exempt.no'|trans }}</span>
                            {% endif %}
                        </dd>

                        {% if profile.activityStartDate is not null %}
                            <dt class="col-sm-5">{{ 'accounting.settings.activity_start_date.label'|trans }}</dt>
                            <dd class="col-sm-7">{{ profile.activityStartDate|format_date('long') }}</dd>
                        {% endif %}
                    </dl>

                    <twig:block name="footer">
                        {% if route_allowed('_settings') %}
                        <a class="btn btn-ghost" href="{{ path('_settings') }}">
                            {{ ux_icon('tabler:settings', {width: 18, height: 18}) }}
                            {{ 'accounting.setup.edit'|trans }}
                        </a>
                        {% endif %}
                    </twig:block>
                </twig:Ui:Card>
            </div>
        </div>

    {% endif %}

    {#
     # The FEC: the books of a financial year in the form the tax
     # administration asks for them, with the notice that goes with it.
     #}
    {% if fecYears|default([]) is not empty and route_allowed('_accounting_fec') %}
        <div class="row row-cards mt-2">
            <div class="col-12">
                <twig:Ui:Card>
                    <twig:block name="header">
                        <div>
                            <h3 class="card-title">{{ 'accounting.fec.title'|trans }}</h3>
                            <p class="card-subtitle text-card-subtitle">{{ 'accounting.fec.subtitle'|trans }}</p>
                        </div>
                    </twig:block>
                    <div class="list-group list-group-flush">
                        {% for fecYear in fecYears %}
                            <div class="list-group-item d-flex flex-wrap align-items-center justify-content-between gap-2">
                                <span class="fw-medium">{{ 'accounting.fec.year'|trans({'%year%': fecYear}) }}</span>
                                <span class="d-flex gap-2">
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('_accounting_fec', {year: fecYear}) }}">
                                        {{ ux_icon('tabler:download', {width: 16, height: 16, 'aria-hidden': 'true'}) }}
                                        {{ 'accounting.fec.download'|trans }}
                                    </a>
                                    <a class="btn btn-sm btn-ghost" href="{{ path('_accounting_fec', {year: fecYear, part: 'notice'}) }}">
                                        {{ 'accounting.fec.notice'|trans }}
                                    </a>
                                </span>
                            </div>
                        {% endfor %}
                    </div>
                    <twig:block name="footer">
                        <span class="text-muted small">{{ 'accounting.fec.help'|trans }}</span>
                    </twig:block>
                </twig:Ui:Card>
            </div>
        </div>
    {% endif %}
{% endblock %}
