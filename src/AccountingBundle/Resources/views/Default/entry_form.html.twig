{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block content %}
    <div class="form-page">
        {{ form_start(form) }}
        {{ form_errors(form) }}

        <div class="form-page-container form-page-container--narrow">
            <div class="form-page-header">
                <div class="form-page-header-content">
                    <div class="form-page-icon">
                        {{ ux_icon('tabler:book', {width: 28, height: 28}) }}
                    </div>
                    <div>
                        <h1 class="form-page-title">
                            {{ entry.id is null ? book.addTranslationKey|trans : 'accounting.entry.form.edit_title'|trans }}
                        </h1>
                        <p class="form-page-subtitle">{{ book.translationKey|trans }}</p>
                    </div>
                </div>
            </div>

            <div class="form-page-sections">
                <section class="form-page-section">
                    <div class="section-header">
                        <div class="section-icon">
                            {{ ux_icon('tabler:pencil', {width: 20, height: 20}) }}
                        </div>
                        <div class="section-header-text">
                            <h2 class="section-title">{{ 'accounting.entry.form.section_title'|trans }}</h2>
                            <p class="section-description">
                                {% if entry.source.isAutomatic %}
                                    {{ 'accounting.entry.form.automatic_notice'|trans }}
                                {% else %}
                                    {{ 'accounting.entry.form.section_description'|trans }}
                                {% endif %}
                            </p>
                        </div>
                    </div>

                    <div class="section-content">
                        <div class="form-grid">
                            <div class="form-field">{{ form_row(form.entryDate) }}</div>
                            <div class="form-field">{{ form_row(form.amount) }}</div>
                            {#
                             # Beside the amount, because that is what it is a
                             # share of: the rate here is the tax *contained* in
                             # the money that moved, never added to it.
                             #}
                            <div class="form-field">{{ form_row(form.tax) }}</div>
                            <div class="form-field form-field-wide">{{ form_row(form.label) }}</div>
                            <div class="form-field">{{ form_row(form.counterpartyName) }}</div>
                            <div class="form-field">{{ form_row(form.documentReference) }}</div>
                            <div class="form-field">{{ form_row(form.settlementMethod) }}</div>
                            {% if form.activityNature is defined %}
                                <div class="form-field">{{ form_row(form.activityNature) }}</div>
                            {% endif %}
                            <div class="form-field form-field-wide">{{ form_row(form.notes) }}</div>
                        </div>
                    </div>
                </section>
                <section class="form-page-section">
                    <div class="section-header">
                        <div class="section-icon">
                            {{ ux_icon('tabler:paperclip', {width: 20, height: 20}) }}
                        </div>
                        <div class="section-header-text">
                            <h2 class="section-title">{{ 'accounting.entry.form.attachments_title'|trans }}</h2>
                            <p class="section-description">{{ 'accounting.entry.form.attachments_description'|trans }}</p>
                        </div>
                    </div>

                    <div class="section-content">
                        {% if entry.attachments is not empty %}
                            <div class="attention-items mb-3">
                                {% for attachment in entry.attachments %}
                                    <div class="attention-item">
                                        <a class="attention-item-main" href="{{ path('_accounting_attachment_download', {'id': attachment.id}) }}">
                                            <span class="attention-item-id">{{ attachment.filename }}</span>
                                            <span class="attention-item-client">
                                                {{ (attachment.size / 1024)|round }} kB · {{ attachment.uploadedAt|format_date('long') }}
                                            </span>
                                        </a>

                                        {#
                                         # A submit button carrying its own formaction rather than a
                                         # nested form: this markup already sits inside the entry's
                                         # form, and a form inside a form is not something a browser
                                         # will parse. The delete button at the foot of the page does
                                         # the same.
                                         #}
                                        {% if entry.isEditable %}
                                            <button
                                                type="submit"
                                                class="btn btn-ghost btn-sm"
                                                formaction="{{ path('_accounting_attachment_delete', {'id': attachment.id}) }}"
                                                formnovalidate
                                                name="_token"
                                                value="{{ csrf_token('delete_attachment' ~ attachment.id) }}"
                                            >
                                                {{ ux_icon('tabler:trash', {width: 16, height: 16}) }}
                                                <span class="visually-hidden">{{ 'accounting.entry.form.delete_attachment'|trans }}</span>
                                            </button>
                                        {% endif %}
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}

                        <div class="form-field form-field-wide">{{ form_row(form.files) }}</div>
                    </div>
                </section>
            </div>

            {{ form_rest(form) }}

            <div class="form-page-actions">
                <div class="form-page-actions-inner">
                    <a href="{{ path('_accounting_book', {'book': book.value}) }}" class="btn btn-ghost">
                        {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
                        {{ 'accounting.entry.form.cancel'|trans }}
                    </a>

                    {# The actions bar spreads its children, so the two that
                       act on this entry are grouped to keep Cancel alone on the
                       left, where every other form page puts it. #}
                    <div class="d-flex align-items-center gap-2">
                        {% if entry.id is not null and entry.isEditable %}
                            <button
                                type="submit"
                                class="btn btn-danger"
                                formaction="{{ path('_accounting_entry_delete', {'id': entry.id}) }}"
                                formnovalidate
                                name="_token"
                                value="{{ csrf_token('delete' ~ entry.id) }}"
                            >
                                {{ ux_icon('tabler:trash', {width: 18, height: 18}) }}
                                {{ 'accounting.entry.form.delete'|trans }}
                            </button>
                        {% endif %}

                        <button type="submit" class="btn btn-primary btn-save">
                            {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                            {{ 'accounting.entry.form.save'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
