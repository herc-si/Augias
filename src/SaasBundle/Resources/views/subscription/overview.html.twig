 #   - trialDaysRemaining: int|null
 #}

{% extends '@AugiasCore/Layout/default.html.twig' %}

{% set status = subscription.status.value %}
{% set statusBadge = {
    'active':    {label: 'saas.overview.status.active',    color: 'success'},
    'trial':     {label: 'saas.overview.status.trial',     color: 'info'},
    'pending':   {label: 'saas.overview.status.pending',   color: 'secondary'},
    'past_due':  {label: 'saas.overview.status.past_due',  color: 'danger'},
    'paused':    {label: 'saas.overview.status.paused',    color: 'warning'},
    'cancelled': {label: 'saas.overview.status.cancelled', color: 'secondary'},
    'expired':   {label: 'saas.overview.status.expired',   color: 'secondary'},
    'unpaid':    {label: 'saas.overview.status.unpaid',    color: 'danger'},
    'inactive':  {label: 'saas.overview.status.inactive',  color: 'secondary'},
}[status] ?? {label: status|capitalize, color: 'secondary'} %}

{% block title %}{{ ux_icon('tabler:receipt-2', {width: 24, height: 24, class: 'me-2'}) }}{{ 'saas.overview.title'|trans }}{% endblock %}

{% block content %}
    <div class="row g-3">
        <div class="col-12">
            {% include '@AugiasSaas/subscription/_cover_offer.html.twig' %}
            {% if coveredBy|default(null) %}
                <twig:Ui:Alert type="info">
                    {{ ux_icon('tabler:building', {width: 20, height: 20, class: 'me-1'}) }}
                    {{ 'saas.overview.covered_by'|trans({'%company%': coveredBy.name}) }}
                </twig:Ui:Alert>
            {% endif %}
            {% if subscription.hasPendingPlanChange() and not coveredBy|default(null) %}
                <div class="alert alert-warning d-flex align-items-center" role="alert">
                    {{ ux_icon('tabler:arrow-down-circle', {width: 20, height: 20, class: 'me-2'}) }}
                    <div class="flex-fill">
                        <strong>{{ 'saas.overview.pending_change_title'|trans }}</strong> —
                        {{ 'saas.overview.pending_change_message'|trans({
                            '%plan%': subscription.pendingPlan.name,
                            '%date%': subscription.pendingPlanChangeAt|format_date('medium'),
                        }) }}
                    </div>
                    <form method="post" action="{{ path('saas_subscription_cancel_downgrade') }}" class="ms-3">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_downgrade') }}">
                        <button type="submit" class="btn btn-sm btn-outline-warning">
                            {{ 'saas.overview.cancel_change'|trans }}
                        </button>
                    </form>
                </div>
            {% endif %}

            {% if isTrial %}
                <div class="alert alert-info" role="alert">
                    {{ ux_icon('tabler:clock', {width: 20, height: 20, class: 'me-2'}) }}
                    {% if trialDaysRemaining is not null and trialDaysRemaining > 0 %}
                        <strong>{{ 'saas.overview.trial_days_left'|trans({'%count%': trialDaysRemaining}) }}</strong> —
                        {{ 'saas.overview.trial_keep_features'|trans }}
                    {% else %}
                        <strong>{{ 'saas.overview.trial_ended'|trans }}</strong>
                        {{ 'saas.overview.choose_to_continue'|trans }}
                    {% endif %}
                </div>
            {% endif %}

            {% if isPastDue %}
                <div class="alert alert-danger" role="alert">
                    {{ ux_icon('tabler:alert-triangle', {width: 20, height: 20, class: 'me-2'}) }}
                    <strong>{{ 'saas.overview.past_due_title'|trans }}.</strong>
                    {{ 'saas.overview.past_due_message'|trans }}
                </div>
            {% endif %}

            {% if isPaused %}
                <div class="alert alert-warning" role="alert">
                    {{ ux_icon('tabler:player-pause', {width: 20, height: 20, class: 'me-2'}) }}
                    {{ 'saas.overview.paused_message'|trans }}
                </div>
            {% endif %}
        </div>

        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex align-items-center justify-content-between">
                    <h3 class="card-title mb-0">{{ 'saas.overview.current_plan'|trans }}</h3>
                    <span class="badge bg-{{ statusBadge.color }}-lt">{{ statusBadge.label|trans }}</span>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-baseline gap-3 mb-3">
                        <h2 class="mb-0">{{ plan_label(plan) }}</h2>
                        {% if isFree %}
                            <span class="text-subtle">{{ 'saas.overview.free'|trans }}</span>
                        {% else %}
                            <span class="text-subtle">
                                <span class="money money--total">
                                    <span class="money-currency">{{ plan_currency() }}</span>
                                    <strong class="money-amount">{{ plan.price|formatCurrencyAmount(plan_currency()) }}</strong>
                                </span>{{ (plan_is_annual(plan) ? 'saas.plan.per_year' : 'saas.plan.per_month')|trans }}
                            </span>
                        {% endif %}
                    </div>
                    {% if plan.description is not empty %}
                        <p class="text-subtle">{{ plan.description }}</p>
                    {% endif %}

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-subtle">{{ 'saas.overview.started'|trans }}</dt>
                        <dd class="col-sm-8">{{ subscription.startDate|format_date('medium') }}</dd>

                        {% if isTrial %}
                            <dt class="col-sm-4 text-subtle">{{ 'saas.overview.trial_ends'|trans }}</dt>
                            <dd class="col-sm-8">{{ subscription.endDate|format_date('medium') }}</dd>
                        {% elseif isFree %}
                            <dt class="col-sm-4 text-subtle">{{ 'saas.overview.renewal'|trans }}</dt>
                            <dd class="col-sm-8">{{ 'saas.overview.renewal_none'|trans }}</dd>
                        {% else %}
                            <dt class="col-sm-4 text-subtle">{{ 'saas.overview.next_renewal'|trans }}</dt>
                            <dd class="col-sm-8">{{ subscription.endDate|format_date('medium') }}</dd>
                        {% endif %}
                    </dl>

                    {% block usage %}
                        {# Per-feature usage bars are wired here once feature gates land. #}
                    {% endblock %}
                </div>
                {% if not coveredBy|default(null) %}
                <div class="card-footer d-flex flex-wrap gap-2">
                    <a href="{{ path('saas_subscription_change') }}" class="btn btn-primary">
                        {{ ux_icon('tabler:arrows-exchange', {width: 18, height: 18}) }}
                        {{ 'saas.overview.change_plan'|trans }}
                    </a>
                    {% if hasExternalBilling %}
                        <a href="{{ path('saas_subscription_checkout') }}" class="btn btn-outline-secondary">
                            {{ ux_icon('tabler:credit-card', {width: 18, height: 18}) }}
                            {{ 'saas.overview.manage_payment_method'|trans }}
                        </a>
                    {% endif %}
                </div>
                {% endif %}
            </div>
            {% if not coveredBy|default(null) and companyAllowance|default(1) != 1 %}
                <div class="card mt-3">
                    <div class="card-header">
                        <h3 class="card-title mb-0">{{ 'saas.overview.covered_companies'|trans }}</h3>
                        <span class="badge bg-secondary-lt ms-auto">
                            {% if companyAllowance == -1 %}
                                {{ 'saas.overview.covered_count_unlimited'|trans({'%count%': coveredCompanies|length + 1}) }}
                            {% else %}
                                {{ 'saas.overview.covered_count'|trans({'%count%': coveredCompanies|length + 1, '%max%': companyAllowance}) }}
                            {% endif %}
                        </span>
                    </div>
                    <div class="card-body">
                        <p class="text-subtle">{{ 'saas.overview.covered_help'|trans }}</p>
                        {% if coveredCompanies is not empty %}
                            <ul class="mb-0">
                                {% for covered in coveredCompanies %}
                                    <li>{{ covered.name }}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title mb-0">{{ 'saas.overview.plan_features'|trans }}</h3>
                </div>
                <div class="card-body">
                    {% from '@AugiasSaas/subscription/_plans_grid.html.twig' import feature_list %}
                    {{ feature_list(plan.features) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
