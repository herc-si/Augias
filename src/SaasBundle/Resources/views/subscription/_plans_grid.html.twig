 #
 # Renders the plan picker grid. Expects:
 #   - plans: list<Plan>
 # Optional:
 #   - currentPlanId: string|null  (planId of the user's current plan; that card is disabled)
 #   - actionRoute: string         (form action route name; defaults to saas_subscription_choose)
 #   - csrfToken: string           (CSRF intent; defaults to choose_plan)
 #   - period: 'month'|'year'      (which price a card shows; defaults to the
 #                                  `period` query parameter, else monthly)
 #
 # A plan's yearly twin is not a card of its own: it is the same offer, shown
 # on its monthly plan's card when the yearly period is picked.
 #}

{% import _self as macros %}

{% set currentPlanId = currentPlanId|default(null) %}
{% set actionRoute = actionRoute|default('saas_subscription_choose') %}
{% set csrfToken = csrfToken|default('choose_plan') %}
{% set period = period|default(app.request.query.get('period') == 'year' ? 'year' : 'month') %}
{% set currency = plan_currency() %}

{# Free plan rendered separately below the main grid. #}
{% set freePlan = null %}
{% set paidPlans = [] %}
{% set hasAnnual = false %}
{# Whole months the best yearly price saves, for the period switch to say. #}
{% set freeMonths = 0 %}
{% for plan in plans|filter(plan => not plan_is_annual(plan)) %}
    {% if plan_annual(plan) %}
        {% set hasAnnual = true %}
        {% if plan.price > 0 %}
            {% set freeMonths = max(freeMonths, (plan_yearly_saving(plan, plan_annual(plan)) / plan.price)|round(0, 'floor')) %}
        {% endif %}
    {% endif %}
    {% if plan.isFree() %}
        {% set freePlan = plan %}
    {% else %}
        {% set paidPlans = paidPlans|merge([plan]) %}
    {% endif %}
{% endfor %}

{# Highlight the second-to-last paid plan as recommended (e.g. middle of 3, third of 4). #}
{% set recommendedIndex = paidPlans|length >= 2 ? paidPlans|length - 2 : -1 %}

{% if hasAnnual %}
    {% set route = app.request.attributes.get('_route') %}
    {% set query = app.request.query.all %}
    <div class="d-flex justify-content-center mb-4">
        <div class="btn-group" role="group" aria-label="{{ 'saas.plan.period.label'|trans }}">
            <a href="{{ path(route, query|merge({period: 'month'})) }}" class="btn {{ period == 'month' ? 'btn-primary' : 'btn-outline-primary' }}" {{ period == 'month' ? 'aria-current="true"' }}>
                {{ 'saas.plan.period.month'|trans }}
            </a>
            <a href="{{ path(route, query|merge({period: 'year'})) }}" class="btn {{ period == 'year' ? 'btn-primary' : 'btn-outline-primary' }}" {{ period == 'year' ? 'aria-current="true"' }}>
                {{ 'saas.plan.period.year'|trans }}
                {% if freeMonths > 0 %}
                    <span class="badge bg-success text-white ms-1">{{ 'saas.plan.period.free_months'|trans({'%count%': freeMonths}) }}</span>
                {% endif %}
            </a>
        </div>
    </div>
{% endif %}

<div class="row row-cards row-deck g-4 justify-content-center">
    {% for offer in paidPlans %}
        {% set annual = plan_annual(offer) %}
        {# The card shows the period picked, when the offer has it. #}
        {% set plan = period == 'year' and annual ? annual : offer %}
        {% set isRecommended = loop.index0 == recommendedIndex %}
        {% set isCurrent = currentPlanId is not null and plan.planId == currentPlanId %}
        <div class="col-md-6 col-lg-4 d-flex">
            <div class="card flex-fill plan-card {{ isRecommended and not isCurrent ? 'plan-card-recommended border-primary' : '' }} {{ isCurrent ? 'plan-card-current border-success' : '' }}">
                {% if isCurrent %}
                    <div class="plan-card-banner bg-success">
                        {{ ux_icon('tabler:check', {width: 14, height: 14, class: 'me-1'}) }}
                        {{ 'saas.plan.current'|trans }}
                    </div>
                {% elseif isRecommended %}
                    <div class="plan-card-banner">
                        {{ ux_icon('tabler:star-filled', {width: 14, height: 14, class: 'me-1'}) }}
                        {{ 'saas.plan.recommended'|trans }}
                    </div>
                {% endif %}
                <div class="card-body d-flex flex-column text-start">
                    <h2 class="card-title mb-3">{{ offer.name }}</h2>

                    <div class="plan-card-price mb-3">
                        <span class="money money--total">
                            <span class="money-currency">{{ currency }}</span>
                            <strong class="money-amount">{{ plan.price|formatCurrencyAmount(currency) }}</strong>
                        </span>
                        <span class="plan-card-interval text-subtle">{{ (plan is same as(annual) ? 'saas.plan.per_year' : 'saas.plan.per_month')|trans }}</span>
                        {% if plan is same as(annual) %}
                            {% set saving = plan_yearly_saving(offer, annual) %}
                            <div class="small text-subtle mt-1">
                                {{ 'saas.plan.yearly_equivalent'|trans({'%monthly%': plan_monthly_equivalent(annual)|formatCurrency(currency)}) }}
                                {% if saving > 0 %}
                                    — <span class="text-success">{{ 'saas.plan.yearly_saving'|trans({'%saving%': saving|formatCurrency(currency)}) }}</span>
                                {% endif %}
                            </div>
                        {% elseif annual %}
                            {# The monthly card says what a year would cost, and save. #}
                            {% set saving = plan_yearly_saving(offer, annual) %}
                            <div class="small mt-1">
                                <a href="{{ path(app.request.attributes.get('_route'), app.request.query.all|merge({period: 'year'})) }}" class="text-success">
                                    {{ (saving > 0 ? 'saas.plan.or_yearly_saving' : 'saas.plan.or_yearly')|trans({'%price%': annual.price|formatCurrency(currency), '%saving%': saving|formatCurrency(currency)}) }}
                                </a>
                            </div>
                        {% endif %}
                    </div>

                    {% if offer.description is not empty %}
                        <p class="text-subtle">{{ offer.description }}</p>
                    {% endif %}

                    {{ macros.feature_list(offer.features) }}

                    {% if isCurrent %}
                        <button type="button" class="btn btn-outline-success w-100 mt-auto" disabled>
                            {{ 'saas.plan.current'|trans }}
                        </button>
                    {% else %}
                        <form method="post" action="{{ path(actionRoute) }}" class="mt-auto">
                            <input type="hidden" name="plan" value="{{ plan.planId }}">
                            <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                            <button type="submit" class="btn w-100 {{ isRecommended ? 'btn-primary' : 'btn-outline-primary' }}">
                                {{ ux_icon('tabler:credit-card', {width: 18, height: 18}) }}
                                {{ 'saas.plan.choose'|trans }}
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>
    {% endfor %}
</div>

{% if freePlan is not null %}
    {% set freeIsCurrent = currentPlanId is not null and freePlan.planId == currentPlanId %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-11 d-flex">
            <div class="card flex-fill plan-card-free {{ freeIsCurrent ? 'border-success' : '' }}">
                <div class="card-body">
                    <div class="d-flex flex-column flex-lg-row gap-4 align-items-lg-center">
                        <div class="text-lg-start text-center plan-card-free-header">
                            <div class="text-uppercase text-subtle small fw-semibold mb-1">
                                {{ freeIsCurrent ? 'saas.plan.your_current_plan'|trans : 'saas.plan.just_getting_started'|trans }}
                            </div>
                            <h3 class="h4 mb-1">{{ freePlan.name }}</h3>
                            <div class="text-subtle small">
                                {{ 'saas.plan.no_credit_card'|trans }}
                            </div>
                        </div>

                        <div class="flex-grow-1">
                            {{ macros.feature_list_inline(freePlan.features) }}
                        </div>

                        <div class="plan-card-free-cta">
                            {% if freeIsCurrent %}
                                <button type="button" class="btn btn-outline-success" disabled>
                                    {{ 'saas.plan.current'|trans }}
                                </button>
                            {% else %}
                                <form method="post" action="{{ path(actionRoute) }}">
                                    <input type="hidden" name="plan" value="{{ freePlan.planId }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token(csrfToken) }}">
                                    <button type="submit" class="btn btn-ghost">
                                        {{ ux_icon('tabler:gift', {width: 18, height: 18}) }}
                                        {{ 'saas.plan.continue_free'|trans }}
                                    </button>
                                </form>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}

{% macro feature_list(features) %}
    {% import _self as macros %}
    {% if features|length > 0 %}
        <ul class="list-unstyled mb-4 plan-card-features">
            {% for feature in features|sort((a, b) => b.featureKey <=> a.featureKey)|sort((a, b) => b.toFeatureValue.enabled <=> a.toFeatureValue.enabled) %}
                {% set isBool = feature.type.value == 'boolean' %}
                {% set isEnabled = feature.toFeatureValue.enabled %}
                <li class="d-flex align-items-start gap-2 mb-2">
                    {% if isBool and isEnabled %}
                        {{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-success mt-1 flex-shrink-0'}) }}
                    {% elseif isBool %}
                        {{ ux_icon('tabler:x', {width: 18, height: 18, class: 'text-subtle mt-1 flex-shrink-0'}) }}
                    {% else %}
                        {{ ux_icon('tabler:check', {width: 18, height: 18, class: 'text-success mt-1 flex-shrink-0'}) }}
                    {% endif %}
                    <span>{{ macros.feature_label(feature, isBool, isEnabled) }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% macro feature_list_inline(features) %}
    {% import _self as macros %}
    {% if features|length > 0 %}
        <ul class="list-unstyled mb-0 plan-card-features-inline">
            {% for feature in features|sort((a, b) => b.featureKey <=> a.featureKey)|sort((a, b) => b.toFeatureValue.enabled <=> a.toFeatureValue.enabled) %}
                {% set isBool = feature.type.value == 'boolean' %}
                {% set isEnabled = feature.toFeatureValue.enabled %}
                <li>
                    {% if isBool and isEnabled %}
                        {{ ux_icon('tabler:check', {width: 16, height: 16, class: 'text-success flex-shrink-0'}) }}
                    {% elseif isBool %}
                        {{ ux_icon('tabler:x', {width: 16, height: 16, class: 'text-subtle flex-shrink-0'}) }}
                    {% else %}
                        {{ ux_icon('tabler:check', {width: 16, height: 16, class: 'text-success flex-shrink-0'}) }}
                    {% endif %}
                    <span>{{ macros.feature_label(feature, isBool, isEnabled) }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endmacro %}

{% macro feature_label(feature, isBool, isEnabled) %}
    {# The catalogue's description (platform.yaml) is written for developers
       and in English. What a customer reads comes from the translations; the
       description is only a fallback for a right added without one. #}
    {% set key = 'saas.plan.feature.' ~ feature.featureKey %}
    {% set label = key|trans %}
    {% if label == key %}
        {% set label = feature.description ?: feature.featureKey %}
    {% endif %}
    {% set value = feature.value %}
    {% if isBool %}
        {% if isEnabled %}
            <strong>{{ label }}</strong>
        {% else %}
            <span class="text-subtle">{{ label }}</span>
        {% endif %}
    {% elseif value is iterable %}
        <strong>{{ label }}{{ 'saas.plan.value_separator'|trans }}</strong> {{ value|join(', ') }}
    {% elseif value == -1 %}
        <strong>{{ label }}{{ 'saas.plan.value_separator'|trans }}</strong> {{ 'saas.plan.unlimited'|trans|lower }}
    {% else %}
        <strong>{{ label }}{{ 'saas.plan.value_separator'|trans }}</strong> {{ value }}
    {% endif %}
{% endmacro %}
