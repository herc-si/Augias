{#
 # Asking for help, and every request the company has made: who took it,
 # until when the door stays open, what was done.
 #}
{% extends "@AugiasCore/Layout/default.html.twig" %}

{% set providerName = provider ?: 'support.provider_fallback'|trans %}

{% block title %}
    {{ ux_icon('tabler:lifebuoy', {width: 24, height: 24, class: 'me-2'}) }}
    {{ 'support.title'|trans }}
{% endblock title %}

{% block content %}
    <div class="row g-3">
        <div class="col-lg-7">
            {% if open %}
                <twig:Ui:Card>
                    <twig:block name="header">
                        <h3 class="card-title mb-0">{{ 'support.open.title'|trans }}</h3>
                    </twig:block>

                    <p>
                        {% if open.status.value == 'accepted' %}
                            {{ 'support.open.accepted'|trans({'%provider%': providerName, '%operator%': open.operator, '%date%': open.expiresAt|date('d/m/Y H:i')}) }}
                        {% else %}
                            {{ 'support.open.pending'|trans({'%provider%': providerName, '%date%': open.expiresAt|date('d/m/Y H:i')}) }}
                        {% endif %}
                    </p>
                    <blockquote class="text-secondary mb-3" style="white-space: pre-line">{{ open.message }}</blockquote>

                    <form method="post" action="{{ path('_support_revoke', {id: open.id}) }}" onsubmit="return confirm('{{ 'support.open.revoke_confirm'|trans|e('js') }}')">
                        <input type="hidden" name="_token" value="{{ csrf_token('support_revoke_' ~ open.id) }}">
                        <button class="btn btn-danger">
                            {{ ux_icon('tabler:door-exit', {width: 18, height: 18}) }}
                            {{ 'support.open.revoke'|trans }}
                        </button>
                    </form>
                </twig:Ui:Card>
            {% else %}
                <twig:Ui:Card>
                    <twig:block name="header">
                        <h3 class="card-title mb-0">{{ 'support.ask.title'|trans({'%provider%': providerName}) }}</h3>
                    </twig:block>

                    <p class="text-secondary">{{ 'support.ask.intro'|trans({'%provider%': providerName}) }}</p>

                    {{ form_start(form) }}
                    {{ form_row(form.message) }}
                    {{ form_row(form.hours) }}
                    <button type="submit" class="btn btn-primary">
                        {{ ux_icon('tabler:send', {width: 18, height: 18}) }}
                        {{ 'support.ask.submit'|trans }}
                    </button>
                    {{ form_end(form) }}
                </twig:Ui:Card>
            {% endif %}
        </div>

        <div class="col-lg-5">
            <twig:Ui:Alert type="info" icon="tabler:shield-check">
                <strong>{{ 'support.terms.title'|trans }}</strong>
                <ul class="mb-0 mt-2">
                    <li>{{ 'support.terms.identity'|trans({'%provider%': providerName}) }}</li>
                    <li>{{ 'support.terms.read_only'|trans }}</li>
                    <li>{{ 'support.terms.time'|trans }}</li>
                    <li>{{ 'support.terms.logged'|trans }}</li>
                    <li>{{ 'support.terms.report'|trans }}</li>
                </ul>
            </twig:Ui:Alert>
        </div>
    </div>

    {% if requests is not empty %}
        <twig:Ui:Card class="mt-3">
            <twig:block name="header">
                <h3 class="card-title mb-0">{{ 'support.history.title'|trans }}</h3>
            </twig:block>

            <div class="table-responsive">
                <table class="table table-vcenter card-table">
                    <thead>
                        <tr>
                            <th>{{ 'support.history.requested'|trans }}</th>
                            <th>{{ 'support.history.message'|trans }}</th>
                            <th>{{ 'support.history.status'|trans }}</th>
                            <th>{{ 'support.history.note'|trans }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for request in requests %}
                            {% set expired = request.status.isOpen() and request.isExpired(now) %}
                            <tr>
                                <td class="text-nowrap">
                                    {{ request.requestedAt|date('d/m/Y H:i') }}
                                    <div class="small text-secondary">{{ request.requestedBy }}</div>
                                </td>
                                <td style="white-space: pre-line">{{ request.message }}</td>
                                <td class="text-nowrap">
                                    {% if expired %}
                                        <span class="badge bg-secondary-lt">{{ 'support.status.expired'|trans }}</span>
                                    {% else %}
                                        <span class="badge {{ request.status.isOpen() ? 'bg-warning-lt' : 'bg-secondary-lt' }}">{{ request.status.labelKey()|trans }}</span>
                                    {% endif %}
                                    {% if request.operator %}
                                        <div class="small text-secondary">{{ request.operator }}</div>
                                    {% endif %}
                                    <div class="small text-secondary">
                                        {% if request.endedAt %}
                                            {{ request.endedAt|date('d/m/Y H:i') }}
                                        {% else %}
                                            {{ 'support.history.until'|trans({'%date%': request.expiresAt|date('d/m/Y H:i')}) }}
                                        {% endif %}
                                    </div>
                                </td>
                                <td style="white-space: pre-line">{{ request.note ?? '—' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </twig:Ui:Card>
    {% endif %}
{% endblock content %}
