{% extends '@AugiasSaas/Email/Onboarding/_layout.html.twig' %}

{% block title %}{{ 'onboarding.welcome.subject'|trans({}, 'email') }}{% endblock %}

{% block content %}
    <span class="onb-eyebrow">{{ 'onboarding.welcome.eyebrow'|trans({}, 'email') }}</span>
    {# By first name when there is one: an email address is no name (Rémi, 26/11/2026). #}
    <h1 class="onb-h1">{{ user.firstName ? 'onboarding.welcome.heading_named'|trans({'%name%': user.firstName}, 'email') : 'onboarding.welcome.heading'|trans({}, 'email') }}</h1>
    <p class="onb-p lede">{{ 'onboarding.welcome.lede'|trans({'%date%': trial_end|format_date('long')}, 'email') }}</p>

    <p class="onb-p">{{ 'onboarding.welcome.intro'|trans({}, 'email') }}</p>

    {# Feature tile grid — 2x2 with stacking on mobile via inky columns #}
    {% apply inky_to_html %}
        <row>
            <columns small="12" large="6" class="onb-stack" style="padding: 7px;">
                <div class="onb-feature">
                    <div class="onb-feature-icon">&#127970;</div>
                    <h3>{{ 'onboarding.welcome.feature.company.title'|trans({}, 'email') }}</h3>
                    <p>{{ 'onboarding.welcome.feature.company.desc'|trans({}, 'email') }}</p>
                </div>
            </columns>
            <columns small="12" large="6" class="onb-stack" style="padding: 7px;">
                <div class="onb-feature">
                    <div class="onb-feature-icon">&#128101;</div>
                    <h3>{{ 'onboarding.welcome.feature.clients.title'|trans({}, 'email') }}</h3>
                    <p>{{ 'onboarding.welcome.feature.clients.desc'|trans({}, 'email') }}</p>
                </div>
            </columns>
        </row>
        <row>
            <columns small="12" large="6" class="onb-stack" style="padding: 7px;">
                <div class="onb-feature">
                    <div class="onb-feature-icon accent">&#128196;</div>
                    <h3>{{ 'onboarding.welcome.feature.invoices.title'|trans({}, 'email') }}</h3>
                    <p>{{ 'onboarding.welcome.feature.invoices.desc'|trans({}, 'email') }}</p>
                </div>
            </columns>
            <columns small="12" large="6" class="onb-stack" style="padding: 7px;">
                <div class="onb-feature">
                    <div class="onb-feature-icon accent">&#128232;</div>
                    <h3>{{ 'onboarding.welcome.feature.einvoicing.title'|trans({}, 'email') }}</h3>
                    <p>{{ 'onboarding.welcome.feature.einvoicing.desc'|trans({}, 'email') }}</p>
                </div>
            </columns>
        </row>
    {% endapply %}

    <p class="onb-p" style="margin-top: 24px;">{{ 'onboarding.welcome.closing'|trans({}, 'email') }}</p>

    <div class="onb-cta-wrapper">
        <a href="{{ url('_dashboard') }}" class="onb-cta" rel="external" target="_blank">
            {{ 'onboarding.welcome.cta'|trans({}, 'email') }} &rarr;
        </a>
    </div>
{% endblock %}

{% block ps %}{{ 'onboarding.welcome.ps'|trans({}, 'email')|raw }}{% endblock %}
