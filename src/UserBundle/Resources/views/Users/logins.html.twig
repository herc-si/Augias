{% extends '@AugiasCore/Layout/default.html.twig' %}

{% block title %}
    {{ ux_icon('tabler:history', {width: 24, height: 24, class: 'me-2'}) }}
    {{ 'login_history.company.title'|trans }}
{% endblock title %}

{% block heading %}
    <a class="btn" href="{{ path('_users_list') }}">
        {{ ux_icon('tabler:users', {width: 18, height: 18}) }}
        {{ 'menu.top.users'|trans }}
    </a>
{% endblock %}

{% block content %}
    <twig:Ui:Card>
        <twig:block name="header">
            <h3 class="card-title mb-0">{{ 'login_history.company.card_title'|trans }}</h3>
        </twig:block>

        <p class="text-secondary">
            {{ 'login_history.company.intro'|trans({'%days%': retentionDays}) }}
        </p>

        {% if records is empty %}
            <div class="empty">
                <div class="empty-icon">
                    {{ ux_icon('tabler:history', {width: 48, height: 48, class: 'text-secondary'}) }}
                </div>
                <p class="empty-title">{{ 'login_history.empty.title'|trans }}</p>
                <p class="empty-subtitle text-secondary">{{ 'login_history.company.empty'|trans }}</p>
            </div>
        {% else %}
            {% include '@AugiasUser/LoginHistory/_table.html.twig' with {records, showWho: true} only %}
        {% endif %}
    </twig:Ui:Card>
{% endblock %}
