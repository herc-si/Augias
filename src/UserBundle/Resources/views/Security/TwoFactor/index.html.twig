{% set menuItem = '2fa' %}

{% extends "@AugiasUser/Layout/profile.html.twig" %}

{% block title %}{{ ux_icon('tabler:shield-check', {width: 24, height: 24, class: 'me-2'}) }}{{ 'security.two_factor.title'|trans }}{% endblock title %}

{% block profile_content %}
    <div class="form-page">
        <div class="form-page-container form-page-container--narrow">
            {# Page Header #}
            <div class="form-page-header">
                <div class="form-page-header-content">
                    <div class="form-page-icon form-page-icon--security">
                        {{ ux_icon('tabler:shield-lock', {width: 28, height: 28}) }}
                    </div>
                    <div>
                        <h1 class="form-page-title">{{ 'security.two_factor.title'|trans }}</h1>
                        <p class="form-page-subtitle">{{ 'security.two_factor.subtitle'|trans }}</p>
                    </div>
                </div>
            </div>

            {% if authenticatorAppMissing|default(false) %}
                <div class="alert alert-warning" role="alert">
                    <h4 class="alert-title">{{ 'security.two_factor.required.title'|trans }}</h4>
                    <div class="text-secondary">{{ 'security.two_factor.required.message'|trans }}</div>
                </div>
            {% endif %}

            {# New LiveComponent #}
            <twig:User:TwoFactorSettings />
        </div>
    </div>
{% endblock profile_content %}
