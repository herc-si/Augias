{#
 # Under the quote the client was sent: their answer. Accepting takes their
 # name and a ticked box, "bon pour accord"; declining takes a reason if they
 # want to give one. Once answered, the answer is what shows.
 #}
{% set answers = document_activity(quote)|filter(entry => entry.type.value in ['client_accepted', 'client_declined']) %}
{% set answer = answers|first %}
{% set QuoteStatus = enum('Augias\\QuoteBundle\\Enum\\QuoteStatus') %}

{% if quote.status in [QuoteStatus.Accepted, QuoteStatus.Declined] or workflow_can(quote, 'accept') %}
<div class="card mt-3 no-print" id="answer" data-test="client-answer">
    <div class="card-body">
        {% if quote.status == QuoteStatus.Accepted %}
            <div class="d-flex align-items-center gap-2 text-success">
                {{ ux_icon('tabler:circle-check', {width: 24, height: 24}) }}
                <strong>
                    {% if answer and answer.type.value == 'client_accepted' %}
                        {{ 'quote.client_answer.accepted_by'|trans({'%date%': answer.occurredAt|format_datetime('long', 'short'), '%name%': answer.detail}) }}
                    {% else %}
                        {{ 'quote.client_answer.accepted'|trans }}
                    {% endif %}
                </strong>
            </div>
        {% elseif quote.status == QuoteStatus.Declined %}
            <div class="d-flex align-items-center gap-2 text-muted">
                {{ ux_icon('tabler:circle-x', {width: 24, height: 24}) }}
                <strong>
                    {% if answer and answer.type.value == 'client_declined' %}
                        {{ 'quote.client_answer.declined_on'|trans({'%date%': answer.occurredAt|format_datetime('long', 'short')}) }}
                    {% else %}
                        {{ 'quote.client_answer.declined'|trans }}
                    {% endif %}
                </strong>
            </div>
        {% elseif workflow_can(quote, 'accept') %}
            {% if quote.due and quote.due|date('Y-m-d') < 'now'|date('Y-m-d') %}
                <div class="d-flex align-items-center gap-2 text-warning">
                    {{ ux_icon('tabler:clock', {width: 24, height: 24}) }}
                    <span>{{ 'quote.client_answer.expired'|trans({'%date%': quote.due|format_date('long'), '%company%': company_name()}) }}</span>
                </div>
            {% else %}
                {% set token = csrf_token('quote_answer_' ~ quote.uuid) %}

                <h2 class="h3 mb-1">{{ 'quote.client_answer.title'|trans }}</h2>
                <p class="text-muted mb-3">
                    {{ 'quote.client_answer.summary'|trans({'%id%': quote.quoteId, '%total%': quote.total|formatCurrency(currency)}) }}
                    {% if quote.due %}
                        {{ 'quote.client_answer.valid_until'|trans({'%date%': quote.due|format_date('long')}) }}
                    {% endif %}
                </p>

                <form method="post" action="{{ path('_view_quote_answer', {'uuid': quote.uuid}) }}" data-test="accept-form">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <div class="mb-3">
                        <label class="form-label required" for="client-answer-name">{{ 'quote.client_answer.name'|trans }}</label>
                        <input type="text" class="form-control" id="client-answer-name" name="name" required maxlength="120" autocomplete="name">
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="client-answer-agree" name="agree" value="1" required>
                        <label class="form-check-label" for="client-answer-agree">
                            {{ 'quote.client_answer.agree'|trans({'%id%': quote.quoteId, '%total%': quote.total|formatCurrency(currency)}) }}
                        </label>
                    </div>
                    <button type="submit" name="answer" value="accept" class="btn btn-success">
                        {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                        {{ 'quote.client_answer.accept'|trans }}
                    </button>
                    <p class="small text-muted mt-2 mb-0">{{ 'quote.client_answer.proof'|trans }}</p>
                </form>

                <details class="mt-4">
                    <summary class="text-muted">{{ 'quote.client_answer.decline_toggle'|trans }}</summary>
                    <form method="post" action="{{ path('_view_quote_answer', {'uuid': quote.uuid}) }}" class="mt-3" data-test="decline-form">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <div class="mb-3">
                            <label class="form-label" for="client-answer-reason">{{ 'quote.client_answer.reason'|trans }}</label>
                            <textarea class="form-control" id="client-answer-reason" name="reason" rows="2" maxlength="255"></textarea>
                        </div>
                        <button type="submit" name="answer" value="decline" class="btn btn-outline-danger">
                            {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                            {{ 'quote.client_answer.decline'|trans }}
                        </button>
                    </form>
                </details>
            {% endif %}
        {% endif %}
    </div>
</div>
{% endif %}
