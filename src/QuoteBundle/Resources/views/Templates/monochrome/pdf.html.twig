{#
 # Monochrome Luxury — black page, paper-cream stationery card with the
 # serial as hero, ledger card below for line items and totals.
 #}
{% extends '@AugiasQuote/Templates/_pdf_base.html.twig' %}
{% import '@AugiasQuote/Templates/_macros.html.twig' as q %}

{% set currency = quote.client.currency %}

{% block extra_styles %}
    @page { margin-left: 8mm; margin-right: 8mm; margin-top: 8mm; background-color: #0b0b0b; }
    body { background-color: #0b0b0b; }
{% endblock %}

{% block body_attrs %} bgcolor="#0b0b0b" style="background-color: #0b0b0b;"{% endblock %}

{% block body %}
{# The black of the page is its background, so it runs onto every page, and
   the cards are blocks rather than tables: a table cell cannot break, so with
   many lines mPDF shrank the whole document onto one page (08/10/2026). #}

{# Stationery card — cream paper for the hero / meta section #}
<div style="background-color: #f5f1e8; padding: 16px 22px; margin-bottom: 6px;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; margin-bottom: 16px;">
        <tr>
            <td style="vertical-align: top;">
                <div style="font-size: 8pt; letter-spacing: 4px; text-transform: uppercase; color: #6b6b6b;">
                    {{ 'quote.pdf.title'|trans }}
                </div>
            </td>
            <td style="vertical-align: top; text-align: right;">
                {% if setting('system/company/logo') is not empty %}
                    <div style="margin-bottom: 8px;">{{ app_logo(40) }}</div>
                {% endif %}
                <div style="font-size: 8pt; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b;">
                    {{ company_name() }}
                </div>
            </td>
        </tr>
    </table>

    <div style="font-family: Georgia, serif; font-size: 32pt; color: #1a1a1a; line-height: 1.0; letter-spacing: -1px; margin-bottom: 16px;">
        {{ 'invoice.number_prefix'|trans }} {{ quote.quoteId }}
    </div>

    <table cellpadding="0" cellspacing="0" style="width: 100%; border-top: 1px solid #c8bfa8;">
        <tr>
            <td style="width: 33%; padding: 16px 0 0 0; vertical-align: top;">
                <div style="font-size: 7pt; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; margin-bottom: 4px;">
                    {{ 'quote.to'|trans }}
                </div>
                <div style="font-size: 11pt; font-weight: bold; color: #1a1a1a;">{{ quote.client }}</div>
            </td>
            <td style="width: 33%; padding: 16px 0 0 0; vertical-align: top;">
                <div style="font-size: 7pt; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; margin-bottom: 4px;">
                    {{ 'quote.pdf.date'|trans }}
                </div>
                <div style="font-size: 11pt; color: #1a1a1a;">{{ quote.created|format_date('long') }}</div>
                {% if quote.due %}
                    <div style="font-size: 7pt; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; margin: 10px 0 4px 0;">
                        {{ 'quote.pdf.valid_until'|trans }}
                    </div>
                    <div style="font-size: 11pt; color: #1a1a1a;">{{ quote.due|format_date('long') }}</div>
                    <div style="margin-top: 4px;">{{ q.validity_indicator(quote) }}</div>
                {% endif %}
            </td>
            <td style="width: 34%; padding: 16px 0 0 0; vertical-align: top; text-align: right;">
                <div style="font-size: 7pt; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; margin-bottom: 4px;">
                    {{ 'quote.pdf.total'|trans }}
                </div>
                <div style="font-family: Georgia, serif; font-size: 22pt; font-weight: bold; color: #1a1a1a;">
                    {{ quote.total|formatCurrency(currency) }}
                </div>
            </td>
        </tr>
    </table>
</div>

{# Ledger card — white paper for line items, totals, terms #}
<div style="background-color: #ffffff; padding: 14px 22px;">
    <table cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-bottom: 12px;">
        <thead>
            <tr>
                <th style="padding: 0 0 10px 0; font-size: 7pt; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; text-align: left; border-bottom: 1px solid #d6cdb8;">
                    {{ 'quote.item.heading.description'|trans }}
                </th>
                <th style="padding: 0 0 10px 0; font-size: 7pt; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; text-align: right; border-bottom: 1px solid #d6cdb8;">
                    {{ 'quote.item.heading.qty'|trans }} × {{ 'quote.item.heading.price'|trans }}
                </th>
                <th style="padding: 0 0 10px 0; font-size: 7pt; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #6b6b6b; text-align: right; border-bottom: 1px solid #d6cdb8;">
                    {{ 'quote.item.heading.total'|trans }}
                </th>
            </tr>
        </thead>
        <tbody>
            {% for line in quote.lines %}
                {% if line.note|default(false) %}
                    {# A line of text only: a heading over the lines that follow. #}
                    <tr>
                        <td style="padding: 6px 0; font-size: 10pt; color: #1a1a1a; border-bottom: 1px solid #ebe3d0;" colspan="3"><strong>{{ line.description|nl2br }}</strong></td>
                    </tr>
                {% else %}
                    <tr>
                        <td style="padding: 6px 0; font-size: 10pt; color: #1a1a1a; border-bottom: 1px solid #ebe3d0;">{{ line.description|nl2br }}</td>
                        <td style="padding: 6px 0; font-size: 10pt; color: #6b6b6b; border-bottom: 1px solid #ebe3d0; text-align: right; font-family: Georgia, serif;">{{ line|line_quantity }} × {{ line.price|formatCurrency(currency) }}</td>
                        <td style="padding: 6px 0; font-size: 11pt; color: #1a1a1a; border-bottom: 1px solid #ebe3d0; text-align: right; font-family: Georgia, serif; font-weight: bold;">{{ line.total|formatCurrency(currency) }}</td>
                    </tr>
                {% endif %}
            {% endfor %}
        </tbody>
    </table>

    {{ q.closing_block(quote, currency, {
        subtotalColor: '#1a1a1a',
        labelColor: '#6b6b6b',
        totalBg: '#1a1a1a', totalColor: '#d4a94a', totalLabelColor: '#f5f1e8',
        mono: 'Georgia, serif',
    }, {labelColor: '#6b6b6b', textColor: '#3a3a3a', borderColor: '#ebe3d0'}) }}
</div>
{% endblock %}
