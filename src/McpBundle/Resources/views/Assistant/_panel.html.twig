{# The assistant, docked on the right of every page; it stays open from one page to the next. #}
<button type="button" class="btn btn-primary btn-icon assistant-fab d-lg-none d-print-none" data-assistant-toggle aria-controls="assistant-panel" aria-label="{{ 'assistant.open'|trans }}" title="{{ 'assistant.open'|trans }}">
    {{ ux_icon('tabler:sparkles', {width: 22, height: 22}) }}
</button>

<aside id="assistant-panel" class="assistant-panel d-print-none" hidden aria-labelledby="assistant-panel-title"
       data-controller="assistant-panel"
       data-assistant-panel-url-value="{{ path('_assistant_messages') }}"
       data-assistant-panel-token-value="{{ csrf_token('assistant') }}"
       data-assistant-panel-error-value="{{ 'assistant.unavailable'|trans }}">
    <header class="assistant-panel-header">
        <h3 id="assistant-panel-title" class="assistant-panel-title">
            {{ ux_icon('tabler:sparkles', {width: 20, height: 20}) }}
            {{ 'assistant.title'|trans }}
        </h3>
        <div class="d-flex align-items-center gap-1">
            <button type="button" class="btn btn-ghost btn-sm" data-action="assistant-panel#reset" data-assistant-panel-target="reset" title="{{ 'assistant.reset'|trans }}">
                {{ ux_icon('tabler:circle-plus', {width: 18, height: 18}) }}
                <span class="d-none d-sm-inline">{{ 'assistant.reset'|trans }}</span>
            </button>
            <button type="button" class="btn-close" data-action="assistant-panel#close" aria-label="{{ 'assistant.close'|trans }}"></button>
        </div>
    </header>

    <div class="assistant-panel-body" data-assistant-panel-target="scroller" aria-live="polite">
        <div class="assistant-panel-empty" data-assistant-panel-target="empty">
            <p class="text-secondary mb-2">{{ 'assistant.intro'|trans({'%company%': company_name()}) }}</p>
            <p class="text-secondary mb-2">{{ 'assistant.examples_title'|trans }}</p>
            {% for example in ['assistant.example_1', 'assistant.example_2', 'assistant.example_3'] %}
                <button type="button" class="assistant-example" data-action="assistant-panel#example">{{ example|trans }}</button>
            {% endfor %}
        </div>
        <div data-assistant-panel-target="messages"></div>
        <div class="assistant-message assistant-message-assistant assistant-thinking" data-assistant-panel-target="thinking" hidden>
            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>{{ 'assistant.thinking'|trans }}
        </div>
        <div class="alert alert-danger mt-2 mb-0" data-assistant-panel-target="error" hidden></div>
    </div>

    <form class="assistant-panel-form" data-action="assistant-panel#ask">
        <textarea class="form-control" rows="2" maxlength="2000" required
                  placeholder="{{ 'assistant.question'|trans }}" aria-label="{{ 'assistant.question'|trans }}"
                  data-assistant-panel-target="input"
                  data-action="keydown->assistant-panel#keydown input->assistant-panel#keepDraft"></textarea>
        <div class="d-flex justify-content-between align-items-center mt-2 gap-2">
            <small class="text-secondary">{{ 'assistant.read_only_short'|trans }}</small>
            <button type="submit" class="btn btn-primary" data-assistant-panel-target="submit">
                {{ ux_icon('tabler:send', {width: 18, height: 18}) }} {{ 'assistant.ask'|trans }}
            </button>
        </div>
    </form>
</aside>
