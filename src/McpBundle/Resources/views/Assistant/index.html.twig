{% extends '@AugiasCore/Layout/default.html.twig' %}

{% block title %}{{ ux_icon('tabler:sparkles', {width: 24, height: 24, class: 'me-2'}) }}{{ 'assistant.title'|trans }}{% endblock %}

{% block content %}
    <div class="settings-page">
        {% include "@AugiasCore/flash.html.twig" %}

        <p class="text-secondary">{{ 'assistant.intro'|trans({'%company%': company.name}) }}</p>

        <div class="card mb-3" id="assistant-conversation">
            <div class="card-body">
                {% for message in history %}
                    <div class="mb-3 d-flex {{ message.role == 'user' ? 'justify-content-end' }}">
                        <div class="p-3 rounded {{ message.role == 'user' ? 'bg-primary-lt' : 'bg-light' }}" style="max-width: 85%; white-space: pre-wrap">{{ message.content }}</div>
                    </div>
                {% else %}
                    <p class="text-secondary mb-2">{{ 'assistant.examples_title'|trans }}</p>
                    <ul class="text-secondary mb-0">
                        <li>{{ 'assistant.example_1'|trans }}</li>
                        <li>{{ 'assistant.example_2'|trans }}</li>
                        <li>{{ 'assistant.example_3'|trans }}</li>
                    </ul>
                {% endfor %}
            </div>
        </div>

        <form method="post" action="{{ path('_assistant') }}" class="card">
            <div class="card-body">
                <input type="hidden" name="_token" value="{{ csrf_token('assistant') }}">
                <label for="assistant-question" class="form-label">{{ 'assistant.question'|trans }}</label>
                <textarea id="assistant-question" name="question" class="form-control" rows="2" maxlength="2000" required autofocus></textarea>
                <p class="form-hint mt-2">{{ 'assistant.read_only'|trans }}</p>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <button type="submit" name="reset" value="1" formnovalidate class="btn btn-ghost">{{ 'assistant.reset'|trans }}</button>
                <button type="submit" class="btn btn-primary">{{ ux_icon('tabler:send', {width: 18, height: 18}) }} {{ 'assistant.ask'|trans }}</button>
            </div>
        </form>
    </div>
{% endblock %}
