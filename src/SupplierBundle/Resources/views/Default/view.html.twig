{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:building-store', {width: 24, height: 24, class: 'me-2'}) }}{{ client.name }}
    {% if client.isClient %}
        <span class="badge bg-blue-lt ms-2">{{ 'client.menu.list'|trans }}</span>
    {% endif %}
{% endblock title %}

{% block heading %}
    {% if route_allowed('_suppliers_edit') %}
    <a class="btn btn-outline-primary" href="{{ path('_suppliers_edit', {'id': client.id}) }}">
        {{ ux_icon('tabler:pencil', {width: 18, height: 18}) }}
        {{ 'action.edit'|trans }}
    </a>
    {% endif %}
{% endblock %}

{% block content %}
    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="doc-sidebar-card">
                <div class="doc-sidebar-card-header">
                    <div class="doc-sidebar-card-icon">
                        {{ ux_icon('tabler:address-book', {width: 18, height: 18}) }}
                    </div>
                    <h3 class="doc-sidebar-card-title">{{ 'supplier.view.details'|trans }}</h3>
                </div>
                <div class="doc-sidebar-card-body">
                    <div class="doc-summary-grid">
                        {% set primaryContact = client.contacts|first %}
                        {% if primaryContact %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'supplier.form.email.label'|trans }}</span>
                                <span class="summary-value"><a href="mailto:{{ primaryContact.email }}">{{ primaryContact.email }}</a></span>
                            </div>
                        {% endif %}
                        {% set primaryAddress = client.addresses|first %}
                        {% if primaryAddress and not primaryAddress.isEmpty %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'supplier.view.address'|trans }}</span>
                                <span class="summary-value">{{ primaryAddress }}</span>
                            </div>
                        {% endif %}
                        {% if client.taxIdentifiers|length > 0 %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'supplier.form.tax_identifier.label'|trans }}</span>
                                <span class="summary-value">
                                    {% for identifier in client.taxIdentifiers %}
                                        {{ identifier.label }}: {{ identifier.value }}{% if not loop.last %}<br>{% endif %}
                                    {% endfor %}
                                </span>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="doc-sidebar-card mt-3">
                <div class="doc-sidebar-card-header">
                    <div class="doc-sidebar-card-icon">
                        {{ ux_icon('tabler:receipt', {width: 18, height: 18}) }}
                    </div>
                    <h3 class="doc-sidebar-card-title">{{ 'bill.menu.list'|trans }}</h3>
                </div>
                <div class="doc-sidebar-card-body">
                    <twig:DataGrid name="bill_grid" :context="bill_grid_context" />
                </div>
            </div>
        </div>
    </div>
{% endblock %}
