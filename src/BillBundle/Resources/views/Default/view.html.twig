{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:receipt', {width: 24, height: 24, class: 'me-2'}) }}{{ bill.supplier.name }}
    {{ bill_label(bill.status) }}
{% endblock title %}

{% block heading %}
    <div class="btn-list">
        {% if workflow_can(bill, 'edit') %}
            {% if route_allowed('_bills_edit') %}
            <a class="btn btn-outline-primary" href="{{ path('_bills_edit', {'id': bill.id}) }}">
                {{ ux_icon('tabler:pencil', {width: 18, height: 18}) }}
                {{ 'action.edit'|trans }}
            </a>
            {% endif %}
        {% endif %}

        {% if workflow_can(bill, 'confirm') %}
            {% if route_allowed('_bills_action') %}
            <a class="btn btn-primary" href="{{ path('_bills_action', {'action': 'confirm', 'id': bill.id}) }}">
                {{ ux_icon('tabler:check', {width: 18, height: 18}) }}
                {{ 'action.confirm'|trans }}
            </a>
            {% endif %}
        {% endif %}

        {% if workflow_can(bill, 'reopen') %}
            {% if route_allowed('_bills_action') %}
            <a class="btn btn-outline-secondary" href="{{ path('_bills_action', {'action': 'reopen', 'id': bill.id}) }}">
                {{ ux_icon('tabler:refresh', {width: 18, height: 18}) }}
                {{ 'action.reopen'|trans }}
            </a>
            {% endif %}
        {% endif %}

        {% if workflow_can(bill, 'cancel') %}
            {% if route_allowed('_bills_action') %}
            <a class="btn btn-outline-danger" href="{{ path('_bills_action', {'action': 'cancel', 'id': bill.id}) }}">
                {{ ux_icon('tabler:x', {width: 18, height: 18}) }}
                {{ 'action.cancel'|trans }}
            </a>
            {% endif %}
        {% endif %}

        {% if workflow_can(bill, 'archive') %}
            {% if route_allowed('_bills_action') %}
            <a class="btn btn-outline-secondary" href="{{ path('_bills_action', {'action': 'archive', 'id': bill.id}) }}">
                {{ ux_icon('tabler:archive', {width: 18, height: 18}) }}
                {{ 'action.archive'|trans }}
            </a>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}

{% block content %}
    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="doc-sidebar-card">
                <div class="doc-sidebar-card-header">
                    <div class="doc-sidebar-card-icon">
                        {{ ux_icon('tabler:info-circle', {width: 18, height: 18}) }}
                    </div>
                    <h3 class="doc-sidebar-card-title">{{ 'bill.view.details'|trans }}</h3>
                </div>
                <div class="doc-sidebar-card-body">
                    <div class="doc-summary-grid">
                        <div class="summary-item">
                            <span class="summary-label">{{ 'bill.form.supplier.label'|trans }}</span>
                            <span class="summary-value">
                                <a href="{{ path('_suppliers_view', {'id': bill.supplier.id}) }}">{{ bill.supplier.name }}</a>
                            </span>
                        </div>
                        {% if bill.billNumber %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'bill.form.bill_number.label'|trans }}</span>
                                <span class="summary-value">{{ bill.billNumber }}</span>
                            </div>
                        {% endif %}
                        {% if bill.issueDate %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'bill.form.issue_date.label'|trans }}</span>
                                <span class="summary-value">{{ bill.issueDate|format_date('long') }}</span>
                            </div>
                        {% endif %}
                        {% if bill.dueDate %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'bill.form.due_date.label'|trans }}</span>
                                <span class="summary-value">{{ bill.dueDate|format_date('long') }}</span>
                            </div>
                        {% endif %}
                        {% if bill.category %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'bill.form.category.label'|trans }}</span>
                                <span class="summary-value">{{ bill.category.name }}</span>
                            </div>
                        {% endif %}
                        {#
                         # Only when the supplier's tax was recorded. A bill
                         # with none shows a total and nothing else, as it did
                         # before there was anywhere to put the figure.
                         #}
                        {% if bill.taxAmount is not null %}
                            <div class="summary-item">
                                <span class="summary-label">{{ 'bill.view.net'|trans }}</span>
                                <span class="summary-value">{{ bill.netAmount|formatCurrency(bill.currencyCode) }}</span>
                            </div>
                            <div class="summary-item">
                                <span class="summary-label">{{ 'bill.view.tax'|trans }}</span>
                                <span class="summary-value">{{ bill.taxAmount|formatCurrency(bill.currencyCode) }}</span>
                            </div>
                        {% endif %}
                        <div class="summary-item">
                            <span class="summary-label">{{ 'bill.view.total'|trans }}</span>
                            <span class="summary-value">{{ bill.totalAmount|formatCurrency(bill.currencyCode) }}</span>
                        </div>
                        <div class="summary-item">
                            <span class="summary-label">{{ 'bill.view.balance'|trans }}</span>
                            <span class="summary-value">{{ bill.balance.amount|formatCurrency(bill.currencyCode) }}</span>
                        </div>
                    </div>
                    {% if bill.notes %}
                        <div class="mt-3">
                            <span class="summary-label">{{ 'bill.form.notes.label'|trans }}</span>
                            <p>{{ bill.notes }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="doc-sidebar-card mt-3">
                <div class="doc-sidebar-card-header">
                    <div class="doc-sidebar-card-icon">
                        {{ ux_icon('tabler:cash', {width: 18, height: 18}) }}
                    </div>
                    <h3 class="doc-sidebar-card-title">{{ 'bill.payment.menu.list'|trans }}</h3>
                </div>
                <div class="doc-sidebar-card-body">
                    {% if bill.payments|length > 0 %}
                        <table class="table table-vcenter">
                            <thead>
                                <tr>
                                    <th>{{ 'bill.payment.form.paid_date.label'|trans }}</th>
                                    <th>{{ 'bill.payment.form.method.label'|trans }}</th>
                                    <th>{{ 'bill.payment.form.reference.label'|trans }}</th>
                                    <th class="text-end">{{ 'bill.payment.form.amount.label'|trans }}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for payment in bill.payments %}
                                    <tr>
                                        <td>{{ payment.paidDate|format_date('long') }}</td>
                                        <td>{{ payment.method.label|trans }}</td>
                                        <td>{{ payment.reference }}</td>
                                        <td class="text-end">{{ payment.amount|formatCurrency(payment.currencyCode) }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    {% else %}
                        <p class="text-secondary">{{ 'bill.payment.view.empty'|trans }}</p>
                    {% endif %}

                    {% if not bill.balance.isZero and bill.status.value not in ['draft', 'cancelled', 'archived'] and route_allowed('_bills_record_payment') %}
                        <hr>
                        <h4>{{ 'bill.payment.form.add_title'|trans }}</h4>
                        {{ form_start(payment_form, {'action': path('_bills_record_payment', {'id': bill.id})}) }}
                        <div class="form-grid">
                            <div class="form-field">
                                {{ form_row(payment_form.amount) }}
                            </div>
                            <div class="form-field">
                                {{ form_row(payment_form.paidDate) }}
                            </div>
                            <div class="form-field">
                                {{ form_row(payment_form.method) }}
                            </div>
                            <div class="form-field">
                                {{ form_row(payment_form.reference) }}
                            </div>
                            <div class="form-field form-field-wide">
                                {{ form_row(payment_form.notes) }}
                            </div>
                        </div>
                        <button type="submit" class="btn btn-primary mt-2">
                            {{ ux_icon('tabler:cash', {width: 18, height: 18}) }}
                            {{ 'bill.payment.form.submit'|trans }}
                        </button>
                        {{ form_end(payment_form) }}
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
