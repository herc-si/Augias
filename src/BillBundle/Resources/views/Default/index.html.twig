{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block title %}
    {{ ux_icon('tabler:receipt', {width: 24, height: 24, class: 'me-2'}) }}{{ 'bill.menu.list'|trans }}
{% endblock title %}

{% block heading %}
    {% if route_allowed('_bills_add') %}
    <a class="btn btn-primary" href="{{ path("_bills_add") }}">
        {{ ux_icon('tabler:plus', {width: 18, height: 18}) }}
        {{ 'bill.grid.create'|trans }}
    </a>
    {% endif %}
{% endblock %}

{% block content %}
    <twig:PendingReceipts />

    <twig:Ui:Card>
        <twig:DataGrid name="bill_grid" />
    </twig:Ui:Card>
{% endblock %}
