{% extends "@AugiasCore/Layout/default.html.twig" %}

{% block content %}
<div class="form-page">
    {# Outside the bill's own form: a form cannot hold another. #}
    {% if (bill is not defined or bill.id is empty) and route_allowed('_bills_import') %}
        <div class="form-page-container form-page-container--narrow mb-3">
            <twig:Ui:Alert type="info" icon="tabler:upload">
                <form method="post" action="{{ path('_bills_import') }}" enctype="multipart/form-data" class="d-flex flex-column flex-md-row align-items-md-center gap-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('bill_import') }}">
                    <div class="flex-fill">
                        <strong>{{ 'bill.import.title'|trans }}</strong>
                        <div class="small">{{ 'bill.import.help'|trans }}</div>
                    </div>
                    <input type="file" name="invoice" accept=".pdf,.xml" class="form-control form-control-sm w-auto" required>
                    <button class="btn btn-sm btn-primary">{{ 'bill.import.submit'|trans }}</button>
                </form>
            </twig:Ui:Alert>
        </div>
    {% endif %}

    {{ form_start(form) }}

    {{ form_errors(form) }}

    <div class="form-page-container form-page-container--narrow">
        <div class="form-page-header">
            <div class="form-page-header-content">
                <div class="form-page-icon">
                    {{ ux_icon('tabler:receipt', {width: 28, height: 28}) }}
                </div>
                <div>
                    {% if bill is defined and bill.id is not empty %}
                        <h1 class="form-page-title">{{ 'bill.form.edit_title'|trans }}</h1>
                        {% if bill.documentPath %}
                            <p class="form-page-subtitle"><a href="{{ path('_bills_document', {'id': bill.id}) }}" target="_blank" rel="noopener">{{ ux_icon('tabler:paperclip', {width: 16, height: 16}) }} {{ 'bill.view.document'|trans }}</a></p>
                        {% endif %}
                    {% else %}
                        <h1 class="form-page-title">{{ 'bill.form.add_title'|trans }}</h1>
                        <p class="form-page-subtitle">{{ 'bill.form.subtitle'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="form-page-sections">
            <section class="form-page-section">
                <div class="section-content">
                    <div class="form-grid">
                        <div class="form-field">
                            {{ form_row(form.supplier) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.newSupplierName) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.billNumber) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.category) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.issueDate) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.dueDate) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.currencyCode) }}
                        </div>
                        <div class="form-field">
                            {{ form_row(form.totalAmount) }}
                        </div>
                        {% if form.taxAmount is defined %}
                            <div class="form-field">
                                {{ form_row(form.taxAmount) }}
                            </div>
                            <div class="form-field">
                                {{ form_row(form.supplyType) }}
                            </div>
                            <div class="form-field form-field-wide">
                                {{ form_row(form.supplierVatOnDebits) }}
                            </div>
                        {% endif %}
                        <div class="form-field form-field-wide">
                            {{ form_row(form.notes) }}
                        </div>
                    </div>
                </div>
            </section>
        </div>

        {{ form_rest(form) }}

        <div class="form-page-actions">
            <div class="form-page-actions-inner">
                <a href="{{ path('_bills_index') }}" class="btn btn-ghost">
                    {{ ux_icon('tabler:arrow-left', {width: 18, height: 18}) }}
                    {{ 'action.cancel'|trans }}
                </a>
                <button type="submit" class="btn btn-primary btn-save">
                    {{ ux_icon('tabler:device-floppy', {width: 18, height: 18}) }}
                    {{ 'action.save'|trans }}
                </button>
            </div>
        </div>
    </div>

    {{ form_end(form) }}
</div>
{% endblock %}
