<?xml version="1.0" encoding="UTF-8"?>
<!-- http://www.phpunit.de/manual/current/en/appendixes.configuration.html -->
<phpunit
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/13.2/phpunit.xsd"
        colors="true"
        executionOrder="random"
        failOnWarning="true"
        failOnRisky="true"
        failOnPhpunitNotice="true"
        failOnPhpunitDeprecation="true"
        beStrictAboutOutputDuringTests="true"
        beStrictAboutChangesToGlobalState="true"
        displayDetailsOnTestsThatTriggerDeprecations="true"
        displayDetailsOnPhpunitDeprecations="true"
        displayDetailsOnPhpunitNotices="true"
        displayDetailsOnTestsThatTriggerErrors="true"
        displayDetailsOnTestsThatTriggerNotices="true"
        displayDetailsOnTestsThatTriggerWarnings="true"
        bootstrap="tests/bootstrap.php"
        cacheDirectory=".phpunit.cache"
        stderr="true"
>
  <!--
    The installation tests drive a real browser against a Panther-managed web server, which
    runs in its own process with its own database connection. That makes them incompatible
    with the rest of the suite: they cannot see data inside dama/doctrine-test-bundle's
    uncommitted transaction, their own writes are never rolled back, and their setUp()
    deletes AUGIAS_CONFIG_DIR (var/cache/test/config) - a path shared by every
    paratest worker.

    They are therefore excluded by default, so `bin/phpunit` and `bin/paratest` run the rest
    of the suite cleanly. Run them explicitly with `bin/phpunit` and the "group" option set
    to "installation" (without paratest). An explicit group option on the command line
    overrides this exclusion. See the "Run installation tests" step in unit-tests.yml.
  -->
  <!--
    The SaaS tests boot a second kernel (SaasTestKernel), which has its own cache dir and
    therefore its own database. Two kernels in one PHP process do not survive each other:
    each set passes on its own (52 tests for the SaaS kernel, 227 for the rest of
    SaasBundle on the default one) and mixing them empties one of the two databases, which
    is where the "no such table: companies" errors came from. They were not a broken
    feature; they were a broken way of running the tests.

    Same treatment as the installation tests above, and for the same reason: a group
    excluded by default, run in a process of its own.

        bin/phpunit —group saas-kernel

    An explicit group option on the command line overrides this exclusion.
  -->
  <!--
    Same treatment again, for a reason that is understood less well than the two above.
    The migration installer test drives its own SQLite file through its own connection and
    entity manager, and still leaves something behind: with it in the default run, about one
    run in five failed in unrelated tests further down the random order — a ledger lock date
    not enforced, a deleted company's security token still there. Without it, eight runs out
    of eight were green. Cloning the ORM configuration it borrows changed nothing, so what
    escapes is still unidentified.

    Per-test process isolation is not the way out: tests/bootstrap.php clears var/cache/test
    and rebuilds the schema in every process, so a child spawned mid-run destroys the
    database the parent is still using — 685 errors on the first attempt.

        bin/phpunit —group migrations

    Note for db-tests.yml: naming any excluded group on the command line replaces this list
    rather than adding to it, so that workflow has to name this group as well.
  -->
  <groups>
    <exclude>
      <group>installation</group>
      <group>saas-kernel</group>
      <group>migrations</group>
    </exclude>
  </groups>
  <testsuites>
    <testsuite name="Augias Test Suite">
      <directory>src/*Bundle/Tests</directory>
    </testsuite>
  </testsuites>
  <php>
    <ini name="display_errors" value="1"/>
    <ini name="error_reporting" value="-1"/>
    <env name="PANTHER_NO_HEADLESS" value="0"/>
    <env name="PANTHER_APP_ENV" value="test"/>
    <env name="AUGIAS_DATABASE_URL" value="sqlite:///%kernel.cache_dir%/augias_%app_mode%_%env(default:app_mode:TEST_TOKEN)%.db"/>
    <server name="AUGIAS_APP_SECRET" value="$ecretf0rt3st"/>
    <server name="AUGIAS_ENV" value="test"/>
    <server name="AUGIAS_DEBUG" value="0"/>
    <server name="APP_ENV" value="test"/>
    <server name="APP_DEBUG" value="0"/>
    <server name="KERNEL_CLASS" value="Augias\Test\Kernel"/>
    <server name="BROWSER_ALWAYS_START_WEBSERVER" value="1"/>
  </php>
  <extensions>
    <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension" />
    <bootstrap class="Symfony\Component\Panther\ServerExtension"/>
    <bootstrap class="Zenstruck\Browser\Test\BrowserExtension"/>
    <bootstrap class="Zenstruck\Foundry\PHPUnit\FoundryExtension">
      <parameter name="enabled-auto-reset" value="true"/>
    </bootstrap>
  </extensions>
  <source>
    <include>
      <directory>src</directory>
    </include>
    <exclude>
      <directory>src/*Bundle/Resources</directory>
      <directory>src/*Bundle/Tests</directory>
    </exclude>
  </source>
</phpunit>
