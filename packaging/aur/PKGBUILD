# Maintainer: HERC SI <opensource@herc-si.fr>
# AUR package for Augias (pre-built binary)
#
# This PKGBUILD downloads the pre-built binary from GitHub Releases.
# For the automated AUR publishing workflow, version and checksums
# are updated by the publish-packages GitHub Actions workflow.

pkgname=augias-bin
pkgver=${AUGIAS_VERSION:-0.0.0}
pkgrel=1
pkgdesc="The open-source invoicing platform for freelancers and small businesses"
arch=('x86_64' 'aarch64')
url="https://augias.herc-si.fr"
license=('MIT')
depends=()
provides=('augias')
conflicts=('augias')
backup=('etc/augias/augias.env')
install=augias.install

source_x86_64=("augias-${pkgver}-x86_64::https://github.com/SolidInvoice/SolidInvoice/releases/download/${pkgver}/augias-linux-amd64")
source_aarch64=("augias-${pkgver}-aarch64::https://github.com/SolidInvoice/SolidInvoice/releases/download/${pkgver}/augias-linux-arm64")
source=("augias.service::https://raw.githubusercontent.com/SolidInvoice/SolidInvoice/${pkgver}/packaging/systemd/augias.service"
        "augias.env::https://raw.githubusercontent.com/SolidInvoice/SolidInvoice/${pkgver}/packaging/systemd/augias.env")

# Checksums are updated automatically by CI
sha256sums=('SKIP'
            'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    # Install binary
    if [ "$CARCH" = "x86_64" ]; then
        install -Dm755 "augias-${pkgver}-x86_64" "${pkgdir}/usr/bin/augias"
    elif [ "$CARCH" = "aarch64" ]; then
        install -Dm755 "augias-${pkgver}-aarch64" "${pkgdir}/usr/bin/augias"
    fi

    # Install systemd service
    install -Dm644 augias.service "${pkgdir}/usr/lib/systemd/system/augias.service"

    # Install default config
    install -Dm640 augias.env "${pkgdir}/etc/augias/augias.env"

    # Create data directory
    install -dm750 "${pkgdir}/var/lib/augias"
}
