post_install() {
    # Create system user and group
    if ! getent group augias >/dev/null 2>&1; then
        groupadd --system augias
    fi

    if ! getent passwd augias >/dev/null 2>&1; then
        useradd --system --gid augias \
            --home-dir /var/lib/augias --no-create-home \
            --shell /usr/sbin/nologin \
            --comment "Augias service account" augias
    fi

    # Fix ownership
    chown augias:augias /var/lib/augias
    chown root:augias /etc/augias
    chown root:augias /etc/augias/augias.env

    systemctl daemon-reload

    echo ""
    echo "Augias has been installed."
    echo ""
    echo "  Start:   sudo systemctl start augias"
    echo "  Enable:  sudo systemctl enable augias"
    echo "  Config:  /etc/augias/augias.env"
    echo ""
}

post_upgrade() {
    systemctl daemon-reload

    if systemctl is-active --quiet augias; then
        echo "Restarting Augias..."
        systemctl restart augias
    fi
}

pre_remove() {
    if systemctl is-active --quiet augias 2>/dev/null; then
        systemctl stop augias
    fi
    if systemctl is-enabled --quiet augias 2>/dev/null; then
        systemctl disable augias
    fi
}

post_remove() {
    systemctl daemon-reload
}
